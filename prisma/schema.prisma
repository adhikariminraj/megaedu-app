  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Skill {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedByUserId String
  addedBy       User     @relation("SkillAddedBy", fields: [addedByUserId], references: [id])
  name          String
  createdAt     DateTime @default(now())

  @@unique([studentId, addedByUserId, name])
}

// ============================================================
// RESOURCES, EVENTS, OPPORTUNITIES
// ============================================================
model Resource {
  id             String               @id @default(cuid())
  title          String
  description    String?
  fileUrl        String?
  subject        String?
  gradeLevel     String?
  approachId     String?
  approach       EducationalApproach? @relation(fields: [approachId], references: [id])
  schoolId       String?
  school         School?              @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  createdAt      DateTime             @default(now())
}

// ============================================================
// CALENDAR — Kilometer 1
// A pure projection layer sits on top of these models in application
// code (src/lib/calendar.ts's CalendarItem type) — no CalendarEvent
// database model exists or is planned. GeneralCalendarEntry is the one
// genuinely new authoritative source: national/cultural dates have no
// existing schoolId/organizationId-scoped home to belong to. See
// docs/CALENDAR.md.
// ============================================================

// Each row is one concrete, already-resolved Gregorian-date occurrence
// (e.g. "Dashain 2026" is its own row) — never a recurrence rule. Nepal
// uses a lunar/Bikram-Sambat calendar, so almost nothing here repeats
// on a fixed Gregorian date year to year; re-entering next year's dates
// by hand (checked against the Nepal Panchanga Nirnayak Bikash Samiti's
// determination and the Ministry of Home Affairs' annual holiday
// gazette — see prisma/seed-general-calendar.ts) is the deliberate
// design, not a limitation to fix later. bsDateDisplay is a plain,
// unvalidated display string — nothing in this app queries, sorts, or
// computes from a Bikram Sambat value; it exists purely so a Nepali
// reader sees the familiar BS date alongside the Gregorian one.
model GeneralCalendarEntry {
  id String @id @default(cuid())

  // Date-only — compared by calendar-day, never converted to an
  // instant. Client/seed-supplied "YYYY-MM-DD", same convention as
  // Attendance.date/Homework.dueDate.
  date DateTime

  title String

  // "NATIONAL_HOLIDAY" | "OBSERVANCE" | "MEGA_WIDE_EVENT" — plain
  // String, not a Prisma enum, matching this schema's project-wide
  // convention (SQLite's Prisma connector doesn't support them).
  type String

  description String?

  // Display-only, never parsed — see model comment above.
  bsDateDisplay String?

  // ISO country code, defaulting to Nepal — not a region/province
  // hierarchy; nothing today needs finer-grained scoping than "this
  // whole country."
  country String @default("NP")

  // Free-text provenance for whoever curates this by hand (e.g. "NPNS
  // 2083 determination; MoHA holiday gazette 2082/83") — optional,
  // purely for Platform Admin auditability.
  sourceNote String?

  // Soft-deactivate only, matching Section/Subject/FamilyContact's
  // existing convention — a wrongly-entered date is corrected by
  // deactivating the row, never hard-deleting it.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([date])
}

// Calendar K1 — School Events. schoolId is the only owner FK actually
// writable today: the write path (School Admin only) never sets
// organizationId — Organization Events remain a deferred, later
// kilometer. isAllDay is the sole authoritative signal for whether
// startsAt should be read as a real time or ignored for display; an
// all-day Event still stores a real timestamp (Kathmandu local
// midnight, written by the create route) purely because the column is
// non-nullable, but Calendar rendering must never infer semantics from
// that stored time — see docs/CALENDAR.md.
model Event {
  id              String        @id @default(cuid())
  title           String
  description     String?
  startsAt        DateTime
  isAllDay        Boolean       @default(true)
  location        String?
  onlineUrl       String?
  schoolId        String?
  school          School?       @relation(fields: [schoolId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  isActive        Boolean       @default(true)
  createdByUserId String
  createdBy       User          @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([schoolId, startsAt])
}

// Calendar K1.1 — School-scoped institutional calendar rows: date
// RANGES that affect the Day Status layer (VACATION, EXAMINATION,
// SPECIAL_CLOSURE) and single-date institutional ACTIVITIES that never
// do (PTM, RESULT_DAY, REPORT_CARD_DISTRIBUTION). Deliberately one
// model for both shapes rather than two — every row is the same
// "school-scoped, staff-curated, concrete date(s), no computation
// engine" pattern GeneralCalendarEntry already established at the
// network level; affectsDayStatus is a server-derived (never
// client-editable) discriminator, not an independent choice. See
// docs/CALENDAR.md.
//
// category further determines the required date shape, enforced only
// in the write path (src/app/api/schools/[id]/school-calendar/*), never
// at the database level:
//   VACATION / EXAMINATION / SPECIAL_CLOSURE  -> startDate <= endDate (a range), affectsDayStatus: true
//   PTM / RESULT_DAY / REPORT_CARD_DISTRIBUTION -> startDate == endDate (a point), affectsDayStatus: false
//
// This is intentionally NOT where individual ParentTeacherMeeting
// appointments, UnitTest dates, or AssessmentPeriod live — this model
// represents the school-wide PLANNED calendar date only ("First PTM is
// March 20"), never the per-student/per-subject records those other
// models already own.
model SchoolCalendarEntry {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title    String
  category String // "VACATION" | "EXAMINATION" | "SPECIAL_CLOSURE" | "PTM" | "RESULT_DAY" | "REPORT_CARD_DISTRIBUTION"

  // Server-derived from category — never accepted from the client. true
  // only for VACATION/EXAMINATION/SPECIAL_CLOSURE.
  affectsDayStatus Boolean @default(false)

  // Date-only, inclusive range — equal to each other for a point
  // activity (PTM/RESULT_DAY/REPORT_CARD_DISTRIBUTION).
  startDate DateTime
  endDate   DateTime

  description String?

  // Soft-deactivate only, matching Event/GeneralCalendarEntry's existing
  // convention — no DELETE route.
  isActive Boolean @default(true)

  createdByUserId String
  createdBy       User     @relation("SchoolCalendarEntryCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, startDate])
  @@index([schoolId, endDate])
}

model Opportunity {
  id             String        @id @default(cuid())
  title          String
  description    String?
  type           String
  deadline       DateTime?
  applyUrl       String?
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}

// ============================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================
model Subscription {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id])
  plan      String
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endsAt    DateTime?

  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amountCents    Int
  currency       String        @default("NPR")
  status         String        @default("PENDING")
  provider       String?
  providerRef    String?
  createdAt      DateTime      @default(now())
}

// ============================================================
// NEPAL GEOGRAPHY REFERENCE & STRUCTURED ADDRESSES — Phase A
// Province/District/LocalLevel are fixed, seeded reference data —
// vendored from prisma/data/nepal-geography.json and loaded by
// prisma/seed.ts, the same "fixed and seeded once, schools/users only
// ever select from it" role GradeReference already plays for grades.
// Never editable from the application UI.
// ============================================================

model Province {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  order Int    @unique

  districts District[]
  addresses Address[]
}

model District {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  localLevels LocalLevel[]
  addresses   Address[]

  @@index([provinceId])
}

// type: "METROPOLITAN_CITY" | "SUB_METROPOLITAN_CITY" | "MUNICIPALITY" |
// "RURAL_MUNICIPALITY" — plain String, not a Prisma enum, matching this
// schema's existing SQLite-driven convention (see UserRole.role above).
model LocalLevel {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  wardCount  Int
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  addresses Address[]

  @@index([districtId])
}

// One reusable, structured address shared by every kind of address this
// app needs: personal Current/Permanent (userId), School Official
// (schoolId), and — from Phase C — Family/Emergency Contact addresses.
// Exactly one owner FK is set per row, the same nullable-owner-FK idiom
// already used by Event/Program/Resource above (schoolId?/
// organizationId? side by side) — not a new pattern.
//
// wardNumber is a plain bounded Int, validated at the application layer
// against the chosen LocalLevel.wardCount (1..wardCount), mirroring
// AcademicSession's existing "app-level, not DB-level" constraint idiom.
// A dedicated Ward row per number (6,743 of them nationwide) would add
// no query or integrity value a bounds check doesn't already give.
model Address {
  id String @id @default(cuid())

  // "CURRENT" | "PERMANENT" | "OFFICIAL"
  label String

  provinceId   String
  province     Province   @relation(fields: [provinceId], references: [id])
  districtId   String
  district     District   @relation(fields: [districtId], references: [id])
  localLevelId String
  localLevel   LocalLevel @relation(fields: [localLevelId], references: [id])
  wardNumber   Int

  streetAddress String?
  houseNumber   String?

  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  familyContactId String?
  familyContact   FamilyContact? @relation(fields: [familyContactId], references: [id], onDelete: Cascade)

  // Accountability: both a self-service user and, separately, an
  // authorized School Admin correcting a school-record address can
  // write this row — this records who last did so without standing up
  // a full audit-log system for it.
  updatedByUserId String?
  updatedBy       User?   @relation("AddressUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SQLite treats NULL as distinct in a unique index, so these only
  // constrain rows where that owner column is actually set — a School
  // (schoolId set, userId null) and a User (userId set, schoolId null)
  // never collide with each other here.
  @@unique([userId, label])
  @@unique([schoolId, label])
  @@unique([familyContactId, label])
  @@index([provinceId])
  @@index([districtId])
  @@index([localLevelId])
}

// ============================================================
// FAMILY & EMERGENCY CONTACTS — Phase C
// Administrative records only, managed by School Admin, structurally
// separate from Parent/ParentStudent/MEGA ID access. A FamilyContact
// NEVER implies a portal account, and linking one to a User (below) is
// never automatic — no code path in this app sets linkedUserId; it
// exists only for a future, deliberate linking feature.
// ============================================================
model FamilyContact {
  id String @id @default(cuid())

  fullName          String
  // Student context: "FATHER" | "MOTHER" | "GUARDIAN" | "GRANDFATHER" |
  // "GRANDMOTHER" | "BROTHER" | "SISTER" | "UNCLE" | "AUNT" | "OTHER".
  // Teacher context: "SPOUSE" | "FATHER" | "MOTHER" | "BROTHER" |
  // "SISTER" | "SON" | "DAUGHTER" | "OTHER_CLOSE_RELATIVE" | "OTHER".
  // Plain String, not a Prisma enum, matching this schema's existing
  // SQLite-driven convention (see UserRole.role above) — the allowed
  // set is enforced per-context in src/lib/familyContact.ts, not here.
  relationship      String
  // Set only when relationship == "OTHER".
  relationshipOther String?
  mobileNumber      String?

  isPrimaryContact   Boolean @default(false)
  // Student-only concept. Always false for a Teacher-owned contact —
  // never exposed by the Teacher-facing API validation or UI. Kept on
  // this shared model rather than forking a second table over one
  // field (see PRODUCT_RULES.md / Phase D architecture note).
  isGuardian         Boolean @default(false)
  isEmergencyContact Boolean @default(false)

  // Deliberately nullable with no auto-population path — see the
  // section comment above.
  linkedUserId String?
  linkedUser   User?   @relation("FamilyContactLinkedUser", fields: [linkedUserId], references: [id])

  // Exactly one of studentId/teacherId is set per row — the same
  // nullable-owner-FK idiom already used by Address above (userId /
  // schoolId / familyContactId) and Event (schoolId / organizationId).
  // Enforced at the application layer, not the database.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Soft-deactivate only, matching Section/Subject — never hard-deleted
  // once real family/emergency information has been recorded.
  isActive Boolean @default(true)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
