// MEGA.EDU — Database Schema (Prisma)
// PHASE 1, PASS 2: the old Certificate model has been removed and
// replaced by the redesigned one below (recipient/instructor/issuer
// split, with a display-text snapshot). Apply this only after the
// backfill script has been run and its output reviewed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ============================================================
// MEGA ID — unified identity. One account, one or more roles.
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles UserRole[]

  teacherProfile Teacher?
  studentProfile Student?
  parentProfile  Parent?

  administeredSchools       SchoolAdmin[]
  administeredOrganizations OrganizationAdmin[]
  schoolAccountantOf        SchoolAccountant[]
  organizationAccountantOf  OrganizationAccountant[]

  subscriptions Subscription[]
  payments      Payment[]
  notifications Notification[]

  interests           Interest[]
  skillsAdded          Skill[]         @relation("SkillAddedBy")
  instructorProfile    Instructor?
  certificatesReceived Certificate[] @relation("CertificateRecipient")

  gradeDecisionsMade    GradeHistory[]      @relation("GradeHistoryDecidedBy")
  gradeHistoryAuditsMade GradeHistoryAudit[] @relation("GradeHistoryAuditChangedBy")

  attendancesMarked        Attendance[]       @relation("AttendanceMarkedBy")
  attendanceAuditsChanged  AttendanceAudit[]  @relation("AttendanceAuditChangedBy")
  teachingUnitsCreated     TeachingUnit[]     @relation("TeachingUnitCreatedBy")
  teachingPlansCreated     TeachingPlan[]     @relation("TeachingPlanCreatedBy")
  unitTestsCreated         UnitTest[]         @relation("UnitTestCreatedBy")
  unitTestResultsEvaluated UnitTestResult[]   @relation("UnitTestResultEvaluatedBy")

  studentEvaluationsCreated StudentEvaluation[]      @relation("StudentEvaluationCreatedBy")
  studentEvaluationAudits   StudentEvaluationAudit[] @relation("StudentEvaluationAuditChangedBy")
  parentTeacherMeetingsCreated ParentTeacherMeeting[] @relation("ParentTeacherMeetingCreatedBy")
}

// Role is a plain String below, not a Prisma enum — SQLite's connector
// doesn't support native enums, even unused ones. Valid values:
// PLATFORM_ADMIN | SCHOOL_ADMIN | TEACHER | STUDENT | PARENT |
// ORGANIZATION_ADMIN | ACCOUNTANT
model UserRole {
  id     String @id @default(cuid())
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// ============================================================
// SCHOOL
// ============================================================
model School {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  type             String?
  location         String?
  district         String?
  contactEmail     String?
  contactPhone     String?
  gradesOffered    String?
  description      String?
  logoUrl          String?
  coverImageUrl    String?
  verified         Boolean  @default(false)
  isActive         Boolean  @default(true)
  subscriptionTier String   @default("FREE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins        SchoolAdmin[]
  accountants   SchoolAccountant[]
  teachers      Teacher[]
  students      Student[]
  programs      Program[]
  events        Event[]
  opportunities Opportunity[]
  news          NewsPost[]
  approaches    SchoolApproach[]
  resources     Resource[]
  subscriptions Subscription[]

  issuedCertificates     Certificate[] @relation("CertificateIssuerSchool")
  associatedCertificates Certificate[] @relation("CertificateAssociatedSchool")

  academicSessions AcademicSession[]
  grades           SchoolGrade[]
  subjects         Subject[]
  parentTeacherMeetings ParentTeacherMeeting[]
}

model SchoolAdmin {
  id       String @id @default(cuid())
  userId   String
  schoolId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model SchoolAccountant {
  id       String @id @default(cuid())
  userId   String
  schoolId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Program {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
}

model NewsPost {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime @default(now())
}

// ============================================================
// PEOPLE
// ============================================================
model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  bio       String?
  subjects  String?
  position  String   @default("Teacher")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  courseEnrollments CourseEnrollment[]
  // Certificates are tracked via User.certificatesReceived now (the new
  // Certificate model has no direct teacherId link) — access a teacher's
  // certificates through teacher.user.certificatesReceived.

  gradeAssignments TeacherGradeAssignment[]
  academicAssignments TeacherAcademicAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  studentEvaluations StudentEvaluation[]
  parentTeacherMeetings ParentTeacherMeeting[]

  @@index([schoolId])
}

model Student {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
  // Legacy free-text grade. Left in place deliberately — becomes a
  // fallback that's simply no longer written to once a school completes
  // Initial Setup (see GradeHistory below), not something with a single
  // safe moment to drop across every school at once.
  gradeLevel String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Session in which the student most recently changed (added or
  // removed) their Interests. Once this equals the school's currently
  // ACTIVE session, further changes are blocked until a new session
  // starts — at which point it simply no longer matches the new active
  // session's id, so editing re-opens automatically with no rollover
  // logic needed.
  interestsLockedForSessionId String?
  interestsLockedForSession   AcademicSession? @relation(fields: [interestsLockedForSessionId], references: [id])

  parents           ParentStudent[]
  courseEnrollments CourseEnrollment[]
  skills            Skill[]
  gradeHistory      GradeHistory[]
  attendances       Attendance[]
  unitTestResults   UnitTestResult[]
  evaluations       StudentEvaluation[]
  parentTeacherMeetings ParentTeacherMeeting[]

  @@index([schoolId])
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  children ParentStudent[]
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// ============================================================
// ACADEMIC SESSIONS & GRADES — Phase 2
// Additive alongside the legacy Student.gradeLevel free-text field
// above — schools adopt this structure at different times, so there's
// no single moment it becomes safe to drop that field.
// ============================================================

// One school year window for a school. App-level rule (not a DB
// constraint, since SQLite can't express a partial unique index here):
// a school may have at most one row with status "ACTIVE" at a time —
// enforced by checking before create.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // "ACTIVE" | "CLOSED"

  teacherGradeAssignments TeacherGradeAssignment[]
  gradeHistories          GradeHistory[]
  gradeSubjects           GradeSubject[]
  teacherAcademicAssignments TeacherAcademicAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  attendances             Attendance[]
  teachingUnits           TeachingUnit[]
  teachingPlans           TeachingPlan[]
  interestLockedStudents  Student[]
  studentEvaluations      StudentEvaluation[]
  parentTeacherMeetings   ParentTeacherMeeting[]

  @@index([schoolId])
}

// Platform-wide, fixed grade ladder (PP1-PP3, Y1-Y10). Seeded once in
// seed.ts and never school-editable — a school opts into entries from
// this list via SchoolGrade instead of defining its own grades.
model GradeReference {
  id    String @id @default(cuid())
  code  String @unique
  order Int    @unique

  schoolGrades SchoolGrade[]
}

// A school's opt-in to one GradeReference, with its own display label
// ("Class 6" vs "Grade 6" vs just the GradeReference code).
model SchoolGrade {
  id               String         @id @default(cuid())
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeReferenceId String
  gradeReference   GradeReference @relation(fields: [gradeReferenceId], references: [id])
  displayName      String

  teacherAssignments TeacherGradeAssignment[]
  gradeHistories     GradeHistory[] @relation("GradeHistoryGrade")
  outcomeOfHistories GradeHistory[] @relation("GradeHistoryOutcome")
  sections           Section[]
  gradeSubjects      GradeSubject[]
  teacherAcademicAssignments TeacherAcademicAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  attendances        Attendance[]
  teachingUnits      TeachingUnit[]
  teachingPlans      TeachingPlan[]
  studentEvaluations StudentEvaluation[]

  @@unique([schoolId, gradeReferenceId])
  @@index([schoolId])
}

// A school's subdivision of one SchoolGrade ("Section A", "1", "Red").
// Reusable configuration, like SchoolGrade itself — not session-scoped,
// so a school doesn't have to re-create sections every year. No fixed
// maximum; a school creates as many as it needs. Never hard-deleted —
// only renamed or soft-deactivated (isActive) once it may have real
// academic history attached, matching how the rest of this schema never
// exposes a working delete route for anything with historical weight.
model Section {
  id            String      @id @default(cuid())
  schoolGradeId String
  schoolGrade   SchoolGrade @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  name          String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  gradeHistories GradeHistory[]
  teacherAcademicAssignments TeacherAcademicAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  attendances    Attendance[]
  teachingUnits  TeachingUnit[]
  teachingPlans  TeachingPlan[]
  studentEvaluations StudentEvaluation[]

  @@unique([schoolGradeId, name])
  @@index([schoolGradeId])
}

// Per-session teacher-to-grade assignment. Deliberately not carried
// forward automatically when a new session starts — each session gets
// its own assignment rows.
model TeacherGradeAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@unique([teacherId, schoolGradeId, academicSessionId])
  @@index([academicSessionId])
}

// A student's grade placement for one session — the permanent record.
// Nothing is ever deleted or overwritten in place; a repeat or
// promotion creates a new row in the next session. status/outcomeGradeId
// must only ever be written through recordGradeDecision() in
// src/lib/gradeHistory.ts, which pairs every write with a
// GradeHistoryAudit row in the same transaction — including the very
// first placement decision, not just later corrections.
model GradeHistory {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation("GradeHistoryGrade", fields: [schoolGradeId], references: [id])
  // Optional — a school's actual class subdivision for this placement,
  // if it uses sections at all. Never auto-copied from a prior session's
  // row; every new placement starts unassigned and requires an explicit
  // decision. Set at creation time (not audited, like status:"ENROLLED"
  // itself), or changed on an existing row only through reassignSection()
  // in src/lib/gradeHistory.ts, which is audited like any other change.
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  status            String          @default("ENROLLED") // "ENROLLED" | "COMPLETED" | "REPEATED" | "TRANSFERRED" | "LEFT"
  enrolledAt        DateTime        @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?
  decidedBy         User?           @relation("GradeHistoryDecidedBy", fields: [decidedByUserId], references: [id])
  outcomeGradeId    String?
  outcomeGrade      SchoolGrade?    @relation("GradeHistoryOutcome", fields: [outcomeGradeId], references: [id])

  audits GradeHistoryAudit[]

  @@unique([studentId, academicSessionId])
  @@index([schoolGradeId])
  @@index([academicSessionId])
}

// Append-only audit trail for GradeHistory decisions. No update or
// delete route may ever touch this table — recordGradeDecision() and
// reassignSection() are the only writers, and both only ever insert.
// Each row is a full before/after snapshot of the GradeHistory row at
// that moment — previousSectionId/newSectionId are populated whenever
// section changes (via reassignSection()) and simply echo the row's
// current, unchanged section when a status decision is recorded instead
// (via recordGradeDecision()) — so the section a student was actually
// in at any point in the record is never lost, regardless of which kind
// of change produced a given audit row.
model GradeHistoryAudit {
  id                     String       @id @default(cuid())
  gradeHistoryId         String
  gradeHistory           GradeHistory @relation(fields: [gradeHistoryId], references: [id], onDelete: Cascade)
  changedByUserId        String
  changedBy              User         @relation("GradeHistoryAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt              DateTime     @default(now())
  previousStatus         String
  previousOutcomeGradeId String?
  previousSectionId      String?
  newStatus              String
  newOutcomeGradeId      String?
  newSectionId           String?

  @@index([gradeHistoryId])
}

// ============================================================
// SUBJECTS & TEACHER ACADEMIC ASSIGNMENT — Phase 3A
// Additive alongside Phase 2 / the Section system above. Nothing in
// this block changes any existing model's columns.
// ============================================================

// School-wide subject catalog. Reusable across grades and academic
// sessions — a school defines "Mathematics" once, not once per grade.
// Never hard-deleted once a real TeacherAcademicAssignment may
// reference it — deactivate only (isActive), same precedent as
// Section.
model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  gradeSubjects      GradeSubject[]
  teacherAssignments TeacherAcademicAssignment[]
  teachingUnits      TeachingUnit[]
  teachingPlans      TeachingPlan[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Which subjects a grade offers — for ONE academic session. Unlike
// SchoolGrade/Section, this is NOT reusable config: every session gets
// its own rows, never auto-copied from the prior session (same pattern
// as TeacherGradeAssignment) — a new session starts with zero
// GradeSubject rows until the School Admin explicitly configures them.
// This is what keeps a past session's curriculum permanently
// reconstructable even after the school later changes its subject
// list. A real DELETE route is appropriate here (unlike Subject or
// Section) — nothing permanent references a GradeSubject row directly
// (TeacherAcademicAssignment references it, but is itself non-historical,
// freely-editable current-state data, not an audited record), so
// removing one mid-session just corrects that session's offering.
model GradeSubject {
  id                String          @id @default(cuid())
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  createdAt         DateTime        @default(now())

  teacherAssignments TeacherAcademicAssignment[]
  teachingUnits      TeachingUnit[]
  teachingPlans      TeachingPlan[]
  studentEvaluations StudentEvaluation[]
  parentTeacherMeetings ParentTeacherMeeting[]

  @@unique([schoolGradeId, subjectId, academicSessionId])
  @@index([schoolGradeId])
  @@index([academicSessionId])
}

// A teacher's subject-teaching assignment for one session — Teacher ->
// AcademicSession -> SchoolGrade -> optional Section -> Subject.
// sectionId null means grade-wide (every section); non-null means one
// specific section. A teacher may never hold both a grade-wide AND a
// section-specific row for the same (teacherId, academicSessionId,
// schoolGradeId, subjectId) tuple at once — enforced in the route, not
// the DB, because SQL unique indexes treat NULL as distinct from NULL
// so a plain @@unique cannot catch two grade-wide rows colliding (same
// class of app-level rule as the one-ACTIVE-session-per-school check).
// Multiple DIFFERENT teachers CAN hold overlapping assignments for the
// same subject/grade/section — no hierarchy, no primary/assistant
// concept. gradeSubjectId is the source of truth that this subject is
// actually offered at this grade in this session (the FK cannot be
// created otherwise); schoolGradeId/subjectId/academicSessionId are
// denormalized alongside it purely for query convenience. Deliberately
// NOT the same table as TeacherGradeAssignment — see
// docs/PRODUCT_RULES.md for why. Deliberately not audited, same as
// TeacherGradeAssignment — a current, freely-reassignable operational
// assignment, not a permanent historical decision.
model TeacherAcademicAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([teacherId, academicSessionId, schoolGradeId, sectionId, subjectId])
  @@index([academicSessionId])
  @@index([schoolGradeId])
  @@index([subjectId])
  @@index([teacherId])
}

// ============================================================
// SCHOOL ACADEMIC OPERATIONS — Phase 3B
// Additive alongside Phase 2 / the Section system / Phase 3A above.
// Nothing in this block changes any existing model's columns.
// ============================================================

// A designated Class Teacher (sectionId: null, whole grade) or Section
// Teacher (sectionId: set) — special day-to-day responsibility over the
// students in a class/section, e.g. taking attendance. Deliberately a
// separate model from TeacherAcademicAssignment (subject-teaching) —
// different concern, different constraint shape. Unlike
// TeacherAcademicAssignment, grade-wide and section-specific rows are
// allowed to coexist for the SAME grade (e.g. a grade-wide Class
// Teacher plus per-section Section Teachers) — no overlap rule here.
// Uniqueness is on the SLOT, not the teacher: at most one Class/Section
// Teacher per class-or-section per session, while the same teacher can
// hold multiple such slots across different grades/sections. Session-
// scoped, never carried forward (same as TeacherGradeAssignment/
// TeacherAcademicAssignment). Not audited, real DELETE route — current-
// state operational data, not a permanent decision.
model ClassTeacherAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([schoolGradeId, sectionId, academicSessionId])
  @@index([teacherId])
  @@index([academicSessionId])
}

// One row per student per calendar day — never subject-based. date is
// always derived from a "YYYY-MM-DD" string via new Date(dateString)
// (same convention as AcademicSession.startDate/endDate), giving a
// consistent UTC-midnight value regardless of server timezone — the
// server never computes "today" itself. schoolGradeId/sectionId are a
// snapshot of the student's GradeHistory placement at marking time.
model Attendance {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  date              DateTime
  status            String          // PRESENT | ABSENT | LATE | EXCUSED
  remarks           String?
  markedByUserId    String
  markedBy          User            @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])
  markedAt          DateTime        @default(now())

  audits AttendanceAudit[]

  @@unique([studentId, date])
  @@index([schoolGradeId, sectionId, date])
  @@index([academicSessionId])
}

// Append-only correction log for Attendance — mirrors GradeHistoryAudit.
// A correction (status and/or remarks) updates the Attendance row AND
// inserts one of these in the same transaction, via correctAttendance()
// in src/lib/attendance.ts — never a silent overwrite. Both status and
// remarks are captured on every audit row, even if only one changed.
model AttendanceAudit {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedBy       User       @relation("AttendanceAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())
  previousStatus  String
  newStatus       String
  previousRemarks String?
  newRemarks      String?

  @@index([attendanceId])
}

// The teacher's declared teaching-plan context for one subject in one
// grade/section/session: how many Units/Chapters they intend to cover
// in total, and which display term they use ("Unit"/"Chapter"/free
// text — display-only, never enforced). Deliberately separate from
// TeachingUnit — the planned total is a standalone target that doesn't
// move when units are created or completed, and can be entered before
// any TeachingUnit row exists. Optional: no row means no plan is set,
// and progress views fall back to raw counts with no percentage-of-
// plan. Write path is find-or-update-else-create (app-level, not a
// bare insert) since at most one plan should exist per
// (gradeSubjectId, sectionId) — the same low-concurrency reasoning as
// the one-ACTIVE-session-per-school rule, since a plain @@unique can't
// reliably catch two sectionId: null rows colliding.
model TeachingPlan {
  id                String          @id @default(cuid())
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  plannedTotal      Int
  unitLabel         String          @default("Unit")
  createdByUserId   String
  createdBy         User            @relation("TeachingPlanCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([gradeSubjectId, sectionId])
  @@index([academicSessionId])
}

// A subject's curriculum unit/chapter — the school/teacher's own
// wording ("Unit 1: Numbers" or "Chapter 1: Numbers") lives in `title`;
// nothing here forces either term (see TeachingPlan.unitLabel for the
// display preference). gradeSubjectId enforces that a unit can only be
// created for a subject the grade actually offers this session.
// sectionId null = grade-wide unit sequence (shared by every section);
// a real value = that section's own, independent sequence. `order` is
// app-assigned (current count + 1 within its own gradeSubjectId+
// sectionId scope), not a DB unique constraint — the same NULL-in-
// unique-index issue as elsewhere in this schema would resurface for
// grade-wide (sectionId: null) units otherwise.
model TeachingUnit {
  id                String          @id @default(cuid())
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  title             String
  order             Int
  status            String          @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  startedAt         DateTime?
  completedAt        DateTime?
  createdByUserId   String
  createdBy         User            @relation("TeachingUnitCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tests UnitTest[]

  @@index([gradeSubjectId, sectionId])
  @@index([academicSessionId])
}

// A Unit/Chapter Test — created only once its TeachingUnit is
// IN_PROGRESS or COMPLETED (route-level rule, not a DB constraint; see
// PRODUCT_RULES.md). Multiple tests per unit are allowed (e.g. a quiz
// and a chapter test) — no uniqueness constraint blocks it.
model UnitTest {
  id              String       @id @default(cuid())
  unitId          String
  unit            TeachingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title           String
  testDate        DateTime
  maxMarks        Int
  createdByUserId String
  createdBy       User         @relation("UnitTestCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  results UnitTestResult[]

  @@index([unitId])
}

// Pre-created for every currently-enrolled student in the test's scope
// (via GradeHistory, matching the unit's own schoolGradeId/sectionId)
// at test-creation time, status PENDING — so "pending vs. evaluated vs.
// absent" is a real, directly-queryable column, not inferred by
// diffing against a roster that could change later. No retest concept.
model UnitTestResult {
  id                String    @id @default(cuid())
  unitTestId        String
  unitTest          UnitTest  @relation(fields: [unitTestId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            String    @default("PENDING") // PENDING | EVALUATED | ABSENT
  marksObtained     Float?
  remarks           String?
  evaluatedByUserId String?
  evaluatedBy       User?     @relation("UnitTestResultEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  evaluatedAt       DateTime?

  @@unique([unitTestId, studentId])
  @@index([studentId])
}

// ============================================================
// ASSESSMENT & EVALUATION — Phase 3C
// Additive on top of Phase 2/3A/3B — no existing model's columns
// changed, only new relation-array fields. StudentEvaluation is a
// narrative record distinct from UnitTestResult (marks): a Subject
// Teacher's remark (gradeSubjectId set) or a Grade Class/Section
// Teacher's general remark (gradeSubjectId null) about a student's
// broader development. The UI derives "General" vs "Subject" labeling
// from whether gradeSubjectId is set — no separate type field.
// ============================================================

// A teacher's qualitative, narrative evaluation of a student — freely
// editable while private (visibleToParent and visibleToStudent both
// false). Once shared with EITHER audience, further remarks changes
// must go through updateEvaluationRemarks() (src/lib/evaluation.ts),
// which pairs every subsequent edit with a StudentEvaluationAudit row
// in the same transaction — so previously shared information can never
// be silently rewritten. Sharing itself (flipping visibleToParent/
// visibleToStudent to true) is a one-way action in this phase — no
// un-share path exists, matching how a Certificate is permanent once
// issued elsewhere in this schema.
model StudentEvaluation {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId         String
  teacher           Teacher  @relation(fields: [teacherId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section? @relation(fields: [sectionId], references: [id])
  // null = general/pastoral evaluation (Grade Class Teacher or Section
  // Teacher, via requireClassTeacher); set = subject-specific evaluation
  // (Subject Teacher, via requireTeacherAssignment). The UI derives its
  // "General Student Evaluation" vs "Subject Evaluation" label from
  // this field alone.
  gradeSubjectId    String?
  gradeSubject      GradeSubject? @relation(fields: [gradeSubjectId], references: [id])

  remarks           String

  // Two fully independent visibility gates — a Student-visible
  // evaluation is not automatically Parent-visible, or vice versa.
  visibleToParent      Boolean   @default(false)
  sharedWithParentAt   DateTime?
  visibleToStudent     Boolean   @default(false)
  sharedWithStudentAt  DateTime?

  createdByUserId   String
  createdBy         User     @relation("StudentEvaluationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  audits            StudentEvaluationAudit[]
  meetings          ParentTeacherMeeting[]

  // NOTE: this constraint reliably catches an exact duplicate
  // subject-specific slot, but — the same NULL≠NULL unique-index gap
  // already found and fixed twice elsewhere in this schema
  // (TeacherAcademicAssignment, ClassTeacherAssignment) — does NOT by
  // itself catch a second general (gradeSubjectId: null) evaluation
  // from the same teacher/student/session. The create route pre-checks
  // that case explicitly, inside the same transaction, from the start.
  @@unique([studentId, teacherId, academicSessionId, gradeSubjectId])
  @@index([studentId])
}

// Append-only correction log for StudentEvaluation, written only once
// an evaluation has been shared with a Parent and/or a Student — mirrors
// GradeHistoryAudit/AttendanceAudit's shape exactly.
model StudentEvaluationAudit {
  id              String   @id @default(cuid())
  evaluationId    String
  evaluation      StudentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedBy       User     @relation("StudentEvaluationAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime @default(now())
  previousRemarks String
  newRemarks      String
}

// A scheduled meeting between a Teacher and a Student's Parent(s),
// initiated by a School Admin or an authorized Teacher — Parents are
// read-only recipients in this phase (see PRODUCT_RULES.md). Covers
// both periodic (bulk-scheduled, e.g. a PTM week for a whole grade) and
// occasional (single) meetings through the same model and the same
// create route — the only difference is how many rows one request
// creates. Parent-visible only; Students have no visibility into this
// model in this phase.
model ParentTeacherMeeting {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  academicSessionId  String
  academicSession    AcademicSession @relation(fields: [academicSessionId], references: [id])
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            Teacher  @relation(fields: [teacherId], references: [id])
  // null = general meeting; set = about one specific subject.
  gradeSubjectId     String?
  gradeSubject       GradeSubject? @relation(fields: [gradeSubjectId], references: [id])
  scheduledAt        DateTime
  location           String?
  onlineUrl          String?
  status             String   @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED"
  outcomeNotes       String?
  // Optional link to an evaluation prepared ahead of the meeting and
  // discussed during it — many meetings may reference the same
  // evaluation (e.g. a follow-up meeting), so this is a plain FK, not a
  // unique one.
  linkedEvaluationId String?
  linkedEvaluation   StudentEvaluation? @relation(fields: [linkedEvaluationId], references: [id])
  createdByUserId    String
  createdBy          User     @relation("ParentTeacherMeetingCreatedBy", fields: [createdByUserId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([studentId])
  @@index([schoolId])
}

// ============================================================
// ORGANIZATIONS
// ============================================================
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  verified    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  admins        OrganizationAdmin[]
  accountants   OrganizationAccountant[]
  courses       Course[]
  events        Event[]
  opportunities Opportunity[]
  resources     Resource[]

  issuedCertificates Certificate[] @relation("CertificateIssuerOrg")
}

model OrganizationAdmin {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OrganizationAccountant {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// ============================================================
// EDUCATIONAL APPROACHES
// ============================================================
model EducationalApproach {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  schools   SchoolApproach[]
  courses   Course[]
  resources Resource[]
}

model SchoolApproach {
  id         String              @id @default(cuid())
  schoolId   String
  approachId String
  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  approach   EducationalApproach @relation(fields: [approachId], references: [id], onDelete: Cascade)

  @@unique([schoolId, approachId])
}

// ============================================================
// MEGA ACADEMY — courses, enrollment, certificates
// ============================================================
model Course {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  approachId     String?
  approach       EducationalApproach? @relation(fields: [approachId], references: [id])
  instructorId   String?
  instructor     Instructor?          @relation(fields: [instructorId], references: [id])

  title       String
  slug        String   @unique
  description String?
  priceCents  Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  modules     CourseModule[]
  enrollments CourseEnrollment[]
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int

  lessons Lesson[]
}

model Lesson {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  content  String
  videoUrl String?
  order    Int
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id])
  progress    Int       @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())

  certificate   Certificate?
}

// --- Certificate — the redesigned model, replacing the old one that
// only supported a single ambiguous teacherId field ---
model Certificate {
  id                String            @id @default(cuid())
  verificationCode  String            @unique @default(cuid())
  recipientUserId   String
  recipient         User              @relation("CertificateRecipient", fields: [recipientUserId], references: [id])
  enrollmentId      String?           @unique
  enrollment        CourseEnrollment? @relation(fields: [enrollmentId], references: [id])
  gradeHistoryId    String?           @unique // reserved for Phase 2
  instructorId      String?
  instructor        Instructor?       @relation(fields: [instructorId], references: [id])

  issuerType            String // "MEGA_EDU" | "ORGANIZATION" | "SCHOOL" | "JOINT"
  issuerOrganizationId  String?
  issuerOrganization    Organization? @relation("CertificateIssuerOrg", fields: [issuerOrganizationId], references: [id])
  issuerSchoolId        String?
  issuerSchool          School?       @relation("CertificateIssuerSchool", fields: [issuerSchoolId], references: [id])
  associatedSchoolId    String?
  associatedSchool      School?       @relation("CertificateAssociatedSchool", fields: [associatedSchoolId], references: [id])

  title String

  recipientNameSnapshot        String
  recipientMegaIdSnapshot      String
  issuerNameSnapshot           String
  associatedSchoolNameSnapshot String?
  instructorNameSnapshot       String?

  issuedAt DateTime @default(now())
}

model Instructor {
  id           String   @id @default(cuid())
  name         String
  megaIdUserId String?  @unique
  megaIdUser   User?    @relation(fields: [megaIdUserId], references: [id])
  createdAt    DateTime @default(now())

  courses      Course[]
  certificates Certificate[]
}

// ============================================================
// IDENTITY LAYER — Interests & Skills
// ============================================================
model Interest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Skill {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedByUserId String
  addedBy       User     @relation("SkillAddedBy", fields: [addedByUserId], references: [id])
  name          String
  createdAt     DateTime @default(now())

  @@unique([studentId, addedByUserId, name])
}

// ============================================================
// RESOURCES, EVENTS, OPPORTUNITIES
// ============================================================
model Resource {
  id             String   @id @default(cuid())
  title          String
  description    String?
  fileUrl        String?
  subject        String?
  gradeLevel     String?
  approachId     String?
  approach       EducationalApproach? @relation(fields: [approachId], references: [id])
  schoolId       String?
  school         School?              @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

model Event {
  id             String   @id @default(cuid())
  title          String
  description    String?
  startsAt       DateTime
  location       String?
  onlineUrl      String?
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

model Opportunity {
  id             String    @id @default(cuid())
  title          String
  description    String?
  type           String
  deadline       DateTime?
  applyUrl       String?
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

// ============================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================
model Subscription {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id])
  plan      String
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endsAt    DateTime?

  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amountCents    Int
  currency       String        @default("NPR")
  status         String        @default("PENDING")
  provider       String?
  providerRef    String?
  createdAt      DateTime      @default(now())
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
