// MEGA.EDU — Database Schema (Prisma)
// PHASE 1, PASS 2: the old Certificate model has been removed and
// replaced by the redesigned one below (recipient/instructor/issuer
// split, with a display-text snapshot). Apply this only after the
// backfill script has been run and its output reviewed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ============================================================
// MEGA ID — unified identity. One account, one or more roles.
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // Shared across every role a person holds (Student/Teacher/Parent/etc.)
  // — one identity, one photo, matching MEGA ID's "one account, many
  // roles" design. Deliberately not duplicated onto Teacher/Student/Parent.
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles UserRole[]

  teacherProfile Teacher?
  studentProfile Student?
  parentProfile  Parent?

  administeredSchools       SchoolAdmin[]
  administeredOrganizations OrganizationAdmin[]
  schoolAccountantOf        SchoolAccountant[]
  organizationAccountantOf  OrganizationAccountant[]

  subscriptions Subscription[]
  payments      Payment[]
  notifications Notification[]

  interests            Interest[]
  skillsAdded          Skill[]       @relation("SkillAddedBy")
  instructorProfile    Instructor?
  certificatesReceived Certificate[] @relation("CertificateRecipient")

  gradeDecisionsMade     GradeHistory[]      @relation("GradeHistoryDecidedBy")
  gradeHistoryAuditsMade GradeHistoryAudit[] @relation("GradeHistoryAuditChangedBy")

  addresses        Address[]
  addressesUpdated Address[] @relation("AddressUpdatedBy")

  // Reverse side of FamilyContact.linkedUserId — see that model's
  // comment. Always empty in practice today (no code sets the field);
  // the relation exists so Prisma's schema is valid, not because any
  // route reads or writes it.
  familyContactLinks FamilyContact[] @relation("FamilyContactLinkedUser")

  attendancesMarked            Attendance[]          @relation("AttendanceMarkedBy")
  attendanceAuditsChanged      AttendanceAudit[]     @relation("AttendanceAuditChangedBy")
  teachingUnitsCreated         TeachingUnit[]        @relation("TeachingUnitCreatedBy")
  eventsCreated                Event[]               @relation("EventCreatedBy")
  schoolCalendarEntriesCreated SchoolCalendarEntry[] @relation("SchoolCalendarEntryCreatedBy")
  teachingPlansCreated         TeachingPlan[]        @relation("TeachingPlanCreatedBy")
  unitTestsCreated             UnitTest[]            @relation("UnitTestCreatedBy")
  unitTestResultsEvaluated     UnitTestResult[]      @relation("UnitTestResultEvaluatedBy")

  studentEvaluationsCreated    StudentEvaluation[]      @relation("StudentEvaluationCreatedBy")
  studentEvaluationAudits      StudentEvaluationAudit[] @relation("StudentEvaluationAuditChangedBy")
  parentTeacherMeetingsCreated ParentTeacherMeeting[]   @relation("ParentTeacherMeetingCreatedBy")

  assessmentResultsEvaluated      AssessmentComponentResult[]      @relation("AssessmentComponentResultEvaluatedBy")
  assessmentComponentResultAudits AssessmentComponentResultAudit[] @relation("AssessmentComponentResultAuditChangedBy")
  assessmentResultsPublished      AssessmentResultPublication[]    @relation("AssessmentResultPublicationPublishedBy")

  markSheetsIssued MarkSheet[] @relation("MarkSheetIssuedBy")

  coScholasticResultsEvaluated CoScholasticResult[] @relation("CoScholasticResultEvaluatedBy")

  homeworkSubmissionAttempts HomeworkSubmissionAttempt[] @relation("HomeworkSubmissionAttemptSubmittedBy")
}

// Role is a plain String below, not a Prisma enum — SQLite's connector
// doesn't support native enums, even unused ones. Valid values:
// PLATFORM_ADMIN | SCHOOL_ADMIN | TEACHER | STUDENT | PARENT |
// ORGANIZATION_ADMIN | ACCOUNTANT
model UserRole {
  id     String @id @default(cuid())
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// ============================================================
// SCHOOL
// ============================================================
model School {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  type             String?
  location         String?
  district         String?
  contactEmail     String?
  contactPhone     String?
  gradesOffered    String?
  description      String?
  logoUrl          String?
  coverImageUrl    String?
  verified         Boolean @default(false)
  isActive         Boolean @default(true)
  subscriptionTier String  @default("FREE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins        SchoolAdmin[]
  accountants   SchoolAccountant[]
  teachers      Teacher[]
  students      Student[]
  programs      Program[]
  events        Event[]
  opportunities Opportunity[]
  news          NewsPost[]
  approaches    SchoolApproach[]
  resources     Resource[]
  subscriptions Subscription[]

  issuedCertificates     Certificate[] @relation("CertificateIssuerSchool")
  associatedCertificates Certificate[] @relation("CertificateAssociatedSchool")

  academicSessions               AcademicSession[]
  grades                         SchoolGrade[]
  subjects                       Subject[]
  parentTeacherMeetings          ParentTeacherMeeting[]
  assessmentFrameworks           AssessmentFramework[]
  gradingScales                  GradingScale[]
  assessmentFrameworkAssignments AssessmentFrameworkAssignment[]
  schoolCalendarEntries          SchoolCalendarEntry[]
  markSheets                     MarkSheet[]
  coScholasticAreas              CoScholasticArea[]
  coScholasticGradeSettings      CoScholasticGradeSetting[]

  // Structured address (label "OFFICIAL") — see Address below. The
  // legacy free-text location/district fields above stay in place
  // alongside this; they're never dropped in the same pass a school
  // adopts the structured form, matching Student.gradeLevel's existing
  // "no single safe moment to migrate everyone at once" precedent.
  addresses Address[]

  // Institutional affiliation history — see TeacherSchoolAffiliation /
  // StudentSchoolAffiliation below. Live and authoritative as of Phase
  // 3 (src/lib/affiliation.ts's JOIN/LEAVE/TRANSFER) — read by
  // src/lib/institutionalContext.ts and My Profile's institutional
  // relationships section (My Profile K1); written by
  // join-school/leave-school/transfer-school and the registration/
  // approval routes. Teacher.schoolId/Student.schoolId (below) remain
  // in sync only for the single-open-affiliation case — see
  // syncTeacherBridgeFields()/syncStudentBridgeFields() for exactly
  // when they stop being trustworthy on their own.
  teacherAffiliations TeacherSchoolAffiliation[]
  studentAffiliations StudentSchoolAffiliation[]

  // Public School Gateway — see Inquiry above.
  inquiries Inquiry[]
}

model SchoolAdmin {
  id       String @id @default(cuid())
  userId   String
  schoolId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model SchoolAccountant {
  id       String @id @default(cuid())
  userId   String
  schoolId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Program {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
}

model NewsPost {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime @default(now())
}

// ============================================================
// PUBLIC INQUIRIES — Public School Gateway, Phase 1
// A public visitor contacting a school. Deliberately one shared model
// across every eventual category (Parent/Student/Admission/Employment/
// Institutional/General/Other) rather than one model per category —
// every category shares the identical lifecycle (visitor -> school ->
// status), so `category` is a plain string discriminator, matching this
// schema's existing convention of never using a Prisma enum (see
// UserRole.role, FamilyContact.relationship). Phase 1 only ever writes
// "GENERAL" here; the column exists so later categories are additive,
// not a model replacement.
//
// This is a communication record only — it never creates a User,
// Parent, Student, Teacher, or any institutional affiliation. A public
// visitor is never assumed to be, or become, an account holder.
// ============================================================
model Inquiry {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // "GENERAL" only in Phase 1. Reserved for later: "PARENT" | "STUDENT" |
  // "TEACHER_EMPLOYMENT" | "ADMISSION" | "INSTITUTIONAL" | "OTHER".
  category String @default("GENERAL")

  // Visitor-supplied — no MEGA ID, no session, never required.
  name    String
  email   String
  phone   String?
  message String

  // "NEW" | "RESOLVED". Kept deliberately binary for Phase 1 — no
  // assignment, no internal notes, no threading (see PRODUCT_RULES.md-
  // style deferral note: these are explicit future-phase decisions, not
  // oversights).
  status String @default("NEW")

  // Captured server-side for basic abuse/rate-limit checks only (see
  // src/app/api/schools/[id]/inquiries/route.ts) — never displayed to
  // any user, never used for anything beyond that.
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([ipAddress, createdAt])
}

// ============================================================
// PEOPLE
// ============================================================
model Teacher {
  id        String   @id @default(cuid())
  // Official institutional name — the source of truth for every
  // institutional display (rosters, attendance, evaluations, report
  // cards, etc). Independent of User.name (the account holder's
  // personal MEGA ID display preference): backfilled from it once at
  // migration time, never auto-synced afterward in either direction.
  fullName  String
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  bio       String?
  subjects  String?
  position  String   @default("Teacher")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  courseEnrollments CourseEnrollment[]
  // Certificates are tracked via User.certificatesReceived now (the new
  // Certificate model has no direct teacherId link) — access a teacher's
  // certificates through teacher.user.certificatesReceived.

  gradeAssignments        TeacherGradeAssignment[]
  academicAssignments     TeacherAcademicAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  studentEvaluations      StudentEvaluation[]
  parentTeacherMeetings   ParentTeacherMeeting[]
  homework                Homework[]
  homeworkCompletionsRecorded   HomeworkCompletion[]      @relation("HomeworkCompletionRecordedBy")
  homeworkCompletionAuditsMade  HomeworkCompletionAudit[] @relation("HomeworkCompletionAuditChangedBy")
  homeworkReviewsGiven          HomeworkReview[]          @relation("HomeworkReviewReviewedBy")

  // Administrative Family & Emergency Contact records — see
  // FamilyContact below. Same structural separation from portal access
  // as Student.familyContacts: never implies or grants MEGA ID/Teacher
  // permissions.
  familyContacts FamilyContact[]

  // Institutional relationship/history — see TeacherSchoolAffiliation
  // below. This is the authoritative relationship layer, live since
  // Phase 3 (src/lib/affiliation.ts) — schoolId/approved/position/
  // subjects above are a convenience bridge synced from it for the
  // single-open-affiliation case only (see syncTeacherBridgeFields()),
  // never the source of truth. My Profile's institutional relationships
  // section (My Profile K1) reads this relation directly, not the
  // bridge fields, precisely so a Teacher with 2+ simultaneous
  // affiliations is shown correctly.
  schoolAffiliations TeacherSchoolAffiliation[]

  @@index([schoolId])
}

model Student {
  id         String   @id @default(cuid())
  // Official institutional name — the source of truth for every
  // institutional display (rosters, attendance, evaluations, report
  // cards, etc). Independent of User.name (the account holder's
  // personal MEGA ID display preference): backfilled from it once at
  // migration time, never auto-synced afterward in either direction.
  fullName   String
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
  // Legacy free-text grade. Left in place deliberately — becomes a
  // fallback that's simply no longer written to once a school completes
  // Initial Setup (see GradeHistory below), not something with a single
  // safe moment to drop across every school at once.
  gradeLevel String?
  approved   Boolean  @default(false)
  // Institutional student data, independent of any User account —
  // never fabricated/backfilled, nullable indefinitely. Date-only
  // semantics (stored as UTC-midnight, matching Attendance.date/
  // AcademicSession.startDate's existing convention) — never a
  // timezone-relative "now" computation, since a birth date has no
  // "which timezone is today" ambiguity to resolve.
  dateOfBirth DateTime?
  createdAt  DateTime @default(now())

  // Session in which the student most recently changed (added or
  // removed) their Interests. Once this equals the school's currently
  // ACTIVE session, further changes are blocked until a new session
  // starts — at which point it simply no longer matches the new active
  // session's id, so editing re-opens automatically with no rollover
  // logic needed.
  interestsLockedForSessionId String?
  interestsLockedForSession   AcademicSession? @relation(fields: [interestsLockedForSessionId], references: [id])

  parents                      ParentStudent[]
  courseEnrollments            CourseEnrollment[]
  skills                       Skill[]
  gradeHistory                 GradeHistory[]
  attendances                  Attendance[]
  unitTestResults              UnitTestResult[]
  evaluations                  StudentEvaluation[]
  parentTeacherMeetings        ParentTeacherMeeting[]
  assessmentComponentResults   AssessmentComponentResult[]
  assessmentResultPublications AssessmentResultPublication[]
  markSheets                   MarkSheet[]
  coScholasticResults          CoScholasticResult[]
  homeworkApplicability        HomeworkApplicability[]
  individualHomeworkAssigned   Homework[]                     @relation("IndividualHomeworkTarget")

  // Administrative Family & Emergency Contact records — see
  // FamilyContact below. Structurally unrelated to `parents` (
  // ParentStudent) above: a contact here never implies or grants a MEGA
  // ID / portal account / Parent role, and a Parent account never
  // implies a FamilyContact record exists.
  familyContacts FamilyContact[]

  // Institutional relationship/history — see StudentSchoolAffiliation
  // below. This is the authoritative relationship layer, live since
  // Phase 3 (src/lib/affiliation.ts) — schoolId/approved above are a
  // convenience bridge synced from it for the single-open-affiliation
  // case only (see syncStudentBridgeFields()), never the source of
  // truth. My Profile's institutional relationships section (My
  // Profile K1) reads this relation directly, including ENDED history.
  schoolAffiliations StudentSchoolAffiliation[]

  @@index([schoolId])
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  children ParentStudent[]
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// ============================================================
// INSTITUTIONAL AFFILIATION — live and authoritative since Phase 3
//
// Teacher/Student are stable, permanent role identities (one per
// person, ever). A TeacherSchoolAffiliation / StudentSchoolAffiliation
// row represents one relationship-period between that identity and one
// School — the piece the identity itself cannot represent, since
// Teacher.schoolId / Student.schoolId is a single field that can only
// ever hold one current value.
//
// This is intentionally the SAME shape already proven in this schema
// for SchoolAdmin/OrganizationAdmin (a join row per relationship,
// keyed by both sides), extended here with a lifecycle and dates,
// applied to Teacher/Student.
//
// These two tables are live: written by the JOIN/LEAVE/TRANSFER/REJOIN
// primitives in src/lib/affiliation.ts, called from
// POST /api/{teacher,student}/{join-school,leave-school,transfer-school}
// and the registration/approval routes; read by
// src/lib/institutionalContext.ts (getAccessibleSchools()/
// verifySchoolAccess()) and by My Profile's institutional relationships
// section (My Profile K1, src/lib/profile.ts). Teacher.schoolId/
// Teacher.approved/Teacher.position/Teacher.subjects and
// Student.schoolId/Student.approved are transitional BRIDGE fields —
// kept in sync automatically only for the zero-or-one-open-affiliation
// case (see syncTeacherBridgeFields()/syncStudentBridgeFields() in
// affiliation.ts) and deliberately left untouched, never guessed, once
// a person has 2+. A handful of not-yet-migrated call sites still read
// the bridge fields directly rather than this table — see
// KNOWN_GAPS.md for the current list — but that is migration debt in
// those call sites, not evidence this table itself is unused.
//
// The lifecycle, as actually implemented:
//   JOIN     — creates a new affiliation row. Never ends an existing
//              affiliation at a different school — a person may be
//              genuinely ACTIVE at more than one school at once (e.g.
//              a part-time teacher; explicitly designed for and tested
//              on the Teacher side).
//   LEAVE    — ends the specific existing affiliation
//              (status -> "ENDED", endDate set). Every other
//              affiliation for that person, at any school, is
//              untouched.
//   TRANSFER — LEAVE (old school) + JOIN (new school), composed as one
//              atomic operation — a thrown AffiliationError rolls back
//              both halves together, never leaving a half-applied
//              transfer.
//   REJOIN   — simply another JOIN for a school the person was
//              previously affiliated with. The old, already-"ENDED"
//              row for that same school is never reopened, mutated,
//              or merged into — two (or more) independent rows for
//              the same (person, school) pair, at different times, is
//              the expected, correct shape, and ENDED rows are never
//              deleted — they are the permanent historical record.
//
// "At most one ACTIVE/PENDING row per (person, school) pair" is
// enforced at the application layer (src/lib/affiliation.ts checks
// before every JOIN), not a database constraint — same "app-level, not
// DB-level" idiom already used by AcademicSession above for its own
// single-ACTIVE-per-school rule, and for the same reason (SQLite can't
// express a partial unique index).
// ============================================================

// One Teacher's relationship-period with one School. Position and
// subjects are legacy/informal, descriptive-only fields carried over
// from Teacher.position/Teacher.subjects — they must never become an
// authorization or academic source of truth. TeacherAcademicAssignment
// remains the sole authoritative record for actual subject/grade
// teaching assignments and assignment-based authorization; nothing
// here changes or duplicates that.
model TeacherSchoolAffiliation {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  // Nullable — never backfilled from Teacher.createdAt, a migration
  // date, or any other synthetic value. A real historical join date is
  // frequently simply not known; guessing one would manufacture false
  // institutional history. Use startDateSource to record why this is
  // null rather than inventing a value.
  startDate       DateTime?
  // "RECORDED" — a real date is known (entered going forward, or a
  //   verified value supplied on a migrated row).
  // "UNKNOWN_MIGRATED" — this row originated from a historical
  //   migration with no reliable start date available; startDate is
  //   deliberately null.
  // Plain String, not a Prisma enum, matching this schema's existing
  // SQLite-driven convention (see UserRole.role above). Defaults to
  // "RECORDED" because that's the expected value for any row created
  // through the ordinary (future) join flow — only a backfill script
  // should ever explicitly set "UNKNOWN_MIGRATED".
  startDateSource String    @default("RECORDED")
  // Null = still ongoing (current or pending).
  endDate         DateTime?
  // "PENDING" | "ACTIVE" | "ENDED" — plain String, same convention as
  // GradeHistory.status above.
  status          String    @default("PENDING")

  // Legacy/informal — see the model-level doc comment above.
  position String  @default("Teacher")
  subjects String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([schoolId])
  @@index([teacherId, schoolId])
}

// One Student's relationship-period with one School — same shape and
// same rules as TeacherSchoolAffiliation above, minus the
// Teacher-specific position/subjects fields. Whether a Student may
// ever hold more than one simultaneously ACTIVE affiliation is
// deliberately left undecided here — this schema does not assume
// either answer; if a one-school-only rule is ever wanted, it belongs
// as a future application-layer check (e.g. inside a Student JOIN
// route), not as a change to this table.
model StudentSchoolAffiliation {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  startDate       DateTime?
  startDateSource String    @default("RECORDED")
  endDate         DateTime?
  status          String    @default("PENDING")

  // The school's own institutional/admission identifier for this one
  // affiliation period — NOT a MEGA ID, and deliberately not named
  // `studentId`, which throughout this schema always means "FK to
  // Student.id." School-specific by design: the same value may
  // legitimately exist at a different school (@@unique below is scoped
  // per schoolId, never global), and a student who leaves and later
  // rejoins this same school gets a NEW affiliation row (see
  // createStudentAffiliation()'s JOIN/re-JOIN behavior) with its own
  // independent admissionNumber — the earlier, now-ENDED row's value
  // stays exactly as it was, forever. Nullable indefinitely; treated as
  // affiliation metadata, not part of the JOIN/LEAVE/TRANSFER/approve
  // lifecycle itself. SQLite/SQL-standard NULL semantics (NULL is never
  // equal to another NULL in a unique index) make @@unique below safe
  // with any number of NULLs at the same school — no application-level
  // duplicate-null guard needed.
  admissionNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([studentId])
  @@index([schoolId])
  @@index([studentId, schoolId])
}

// ============================================================
// ACADEMIC SESSIONS & GRADES — Phase 2
// Additive alongside the legacy Student.gradeLevel free-text field
// above — schools adopt this structure at different times, so there's
// no single moment it becomes safe to drop that field.
// ============================================================

// One school year window for a school. App-level rule (not a DB
// constraint, since SQLite can't express a partial unique index here):
// a school may have at most one row with status "ACTIVE" at a time —
// enforced by checking before create.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // "ACTIVE" | "CLOSED"

  teacherGradeAssignments        TeacherGradeAssignment[]
  gradeHistories                 GradeHistory[]
  gradeSubjects                  GradeSubject[]
  teacherAcademicAssignments     TeacherAcademicAssignment[]
  classTeacherAssignments        ClassTeacherAssignment[]
  attendances                    Attendance[]
  teachingUnits                  TeachingUnit[]
  teachingPlans                  TeachingPlan[]
  interestLockedStudents         Student[]
  studentEvaluations             StudentEvaluation[]
  parentTeacherMeetings          ParentTeacherMeeting[]
  assessmentFrameworkAssignments AssessmentFrameworkAssignment[]
  homework                       Homework[]
  markSheets                     MarkSheet[]
  coScholasticPeriods            CoScholasticPeriod[]
  coScholasticGradeSettings      CoScholasticGradeSetting[]
  CoScholasticResult             CoScholasticResult[]

  @@index([schoolId])
}

// Platform-wide, fixed grade ladder (PP1-PP3, Y1-Y10). Seeded once in
// seed.ts and never school-editable — a school opts into entries from
// this list via SchoolGrade instead of defining its own grades.
model GradeReference {
  id    String @id @default(cuid())
  code  String @unique
  order Int    @unique

  schoolGrades SchoolGrade[]
}

// A school's opt-in to one GradeReference, with its own display label
// ("Class 6" vs "Grade 6" vs just the GradeReference code).
model SchoolGrade {
  id               String         @id @default(cuid())
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeReferenceId String
  gradeReference   GradeReference @relation(fields: [gradeReferenceId], references: [id])
  displayName      String

  teacherAssignments             TeacherGradeAssignment[]
  gradeHistories                 GradeHistory[]                  @relation("GradeHistoryGrade")
  outcomeOfHistories             GradeHistory[]                  @relation("GradeHistoryOutcome")
  sections                       Section[]
  gradeSubjects                  GradeSubject[]
  teacherAcademicAssignments     TeacherAcademicAssignment[]
  classTeacherAssignments        ClassTeacherAssignment[]
  attendances                    Attendance[]
  teachingUnits                  TeachingUnit[]
  teachingPlans                  TeachingPlan[]
  studentEvaluations             StudentEvaluation[]
  assessmentFrameworkAssignments AssessmentFrameworkAssignment[]
  homework                       Homework[]
  coScholasticPeriods            CoScholasticPeriod[]
  coScholasticGradeSettings      CoScholasticGradeSetting[]

  @@unique([schoolId, gradeReferenceId])
  @@index([schoolId])
}

// A school's subdivision of one SchoolGrade ("Section A", "1", "Red").
// Reusable configuration, like SchoolGrade itself — not session-scoped,
// so a school doesn't have to re-create sections every year. No fixed
// maximum; a school creates as many as it needs. Never hard-deleted —
// only renamed or soft-deactivated (isActive) once it may have real
// academic history attached, matching how the rest of this schema never
// exposes a working delete route for anything with historical weight.
model Section {
  id            String      @id @default(cuid())
  schoolGradeId String
  schoolGrade   SchoolGrade @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  name          String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  gradeHistories             GradeHistory[]
  teacherAcademicAssignments TeacherAcademicAssignment[]
  classTeacherAssignments    ClassTeacherAssignment[]
  attendances                Attendance[]
  teachingUnits              TeachingUnit[]
  teachingPlans              TeachingPlan[]
  studentEvaluations         StudentEvaluation[]
  homework                   Homework[]

  @@unique([schoolGradeId, name])
  @@index([schoolGradeId])
}

// Per-session teacher-to-grade assignment. Deliberately not carried
// forward automatically when a new session starts — each session gets
// its own assignment rows.
model TeacherGradeAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@unique([teacherId, schoolGradeId, academicSessionId])
  @@index([academicSessionId])
}

// A student's grade placement for one session — the permanent record.
// Nothing is ever deleted or overwritten in place; a repeat or
// promotion creates a new row in the next session. status/outcomeGradeId
// must only ever be written through recordGradeDecision() in
// src/lib/gradeHistory.ts, which pairs every write with a
// GradeHistoryAudit row in the same transaction — including the very
// first placement decision, not just later corrections.
model GradeHistory {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation("GradeHistoryGrade", fields: [schoolGradeId], references: [id])
  // Optional — a school's actual class subdivision for this placement,
  // if it uses sections at all. Never auto-copied from a prior session's
  // row; every new placement starts unassigned and requires an explicit
  // decision. Set at creation time (not audited, like status:"ENROLLED"
  // itself), or changed on an existing row only through reassignSection()
  // in src/lib/gradeHistory.ts, which is audited like any other change.
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  status            String          @default("ENROLLED") // "ENROLLED" | "COMPLETED" | "REPEATED" | "TRANSFERRED" | "LEFT"
  enrolledAt        DateTime        @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?
  decidedBy         User?           @relation("GradeHistoryDecidedBy", fields: [decidedByUserId], references: [id])
  outcomeGradeId    String?
  outcomeGrade      SchoolGrade?    @relation("GradeHistoryOutcome", fields: [outcomeGradeId], references: [id])

  audits GradeHistoryAudit[]

  @@unique([studentId, academicSessionId])
  @@index([schoolGradeId])
  @@index([academicSessionId])
}

// Append-only audit trail for GradeHistory decisions. No update or
// delete route may ever touch this table — recordGradeDecision() and
// reassignSection() are the only writers, and both only ever insert.
// Each row is a full before/after snapshot of the GradeHistory row at
// that moment — previousSectionId/newSectionId are populated whenever
// section changes (via reassignSection()) and simply echo the row's
// current, unchanged section when a status decision is recorded instead
// (via recordGradeDecision()) — so the section a student was actually
// in at any point in the record is never lost, regardless of which kind
// of change produced a given audit row.
model GradeHistoryAudit {
  id                     String       @id @default(cuid())
  gradeHistoryId         String
  gradeHistory           GradeHistory @relation(fields: [gradeHistoryId], references: [id], onDelete: Cascade)
  changedByUserId        String
  changedBy              User         @relation("GradeHistoryAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt              DateTime     @default(now())
  previousStatus         String
  previousOutcomeGradeId String?
  previousSectionId      String?
  newStatus              String
  newOutcomeGradeId      String?
  newSectionId           String?

  @@index([gradeHistoryId])
}

// ============================================================
// SUBJECTS & TEACHER ACADEMIC ASSIGNMENT — Phase 3A
// Additive alongside Phase 2 / the Section system above. Nothing in
// this block changes any existing model's columns.
// ============================================================

// School-wide subject catalog. Reusable across grades and academic
// sessions — a school defines "Mathematics" once, not once per grade.
// Never hard-deleted once a real TeacherAcademicAssignment may
// reference it — deactivate only (isActive), same precedent as
// Section.
model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  gradeSubjects      GradeSubject[]
  teacherAssignments TeacherAcademicAssignment[]
  teachingUnits      TeachingUnit[]
  teachingPlans      TeachingPlan[]
  homework           Homework[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Which subjects a grade offers — for ONE academic session. Unlike
// SchoolGrade/Section, this is NOT reusable config: every session gets
// its own rows, never auto-copied from the prior session (same pattern
// as TeacherGradeAssignment) — a new session starts with zero
// GradeSubject rows until the School Admin explicitly configures them.
// This is what keeps a past session's curriculum permanently
// reconstructable even after the school later changes its subject
// list. A real DELETE route is appropriate here (unlike Subject or
// Section) — nothing permanent references a GradeSubject row directly
// (TeacherAcademicAssignment references it, but is itself non-historical,
// freely-editable current-state data, not an audited record), so
// removing one mid-session just corrects that session's offering.
model GradeSubject {
  id                String          @id @default(cuid())
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  createdAt         DateTime        @default(now())

  teacherAssignments             TeacherAcademicAssignment[]
  teachingUnits                  TeachingUnit[]
  teachingPlans                  TeachingPlan[]
  studentEvaluations             StudentEvaluation[]
  parentTeacherMeetings          ParentTeacherMeeting[]
  assessmentFrameworkAssignments AssessmentFrameworkAssignment[]
  assessmentComponentResults     AssessmentComponentResult[]
  assessmentResultPublications   AssessmentResultPublication[]
  homework                       Homework[]

  @@unique([schoolGradeId, subjectId, academicSessionId])
  @@index([schoolGradeId])
  @@index([academicSessionId])
}

// A teacher's subject-teaching assignment for one session — Teacher ->
// AcademicSession -> SchoolGrade -> optional Section -> Subject.
// sectionId null means grade-wide (every section); non-null means one
// specific section. A teacher may never hold both a grade-wide AND a
// section-specific row for the same (teacherId, academicSessionId,
// schoolGradeId, subjectId) tuple at once — enforced in the route, not
// the DB, because SQL unique indexes treat NULL as distinct from NULL
// so a plain @@unique cannot catch two grade-wide rows colliding (same
// class of app-level rule as the one-ACTIVE-session-per-school check).
// Multiple DIFFERENT teachers CAN hold overlapping assignments for the
// same subject/grade/section — no hierarchy, no primary/assistant
// concept. gradeSubjectId is the source of truth that this subject is
// actually offered at this grade in this session (the FK cannot be
// created otherwise); schoolGradeId/subjectId/academicSessionId are
// denormalized alongside it purely for query convenience. Deliberately
// NOT the same table as TeacherGradeAssignment — see
// docs/PRODUCT_RULES.md for why. Deliberately not audited, same as
// TeacherGradeAssignment — a current, freely-reassignable operational
// assignment, not a permanent historical decision.
model TeacherAcademicAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([teacherId, academicSessionId, schoolGradeId, sectionId, subjectId])
  @@index([academicSessionId])
  @@index([schoolGradeId])
  @@index([subjectId])
  @@index([teacherId])
}

// ============================================================
// SCHOOL ACADEMIC OPERATIONS — Phase 3B
// Additive alongside Phase 2 / the Section system / Phase 3A above.
// Nothing in this block changes any existing model's columns.
// ============================================================

// A Grade Coordinator (sectionId: null, whole grade) or Class Teacher
// (sectionId: set) responsibility — day-to-day accountability for the
// students in a class/section, e.g. taking attendance. These are
// responsibilities a Teacher holds, not separate teacher types — the
// same person may simultaneously hold subject teaching assignments
// (TeacherAcademicAssignment) plus either or both of these; no
// teaching hierarchy or elevated authority over other teachers is
// implied. Deliberately a separate model from TeacherAcademicAssignment
// (subject-teaching) — different concern, different constraint shape.
// Unlike TeacherAcademicAssignment, grade-wide and section-specific
// rows are allowed to coexist for the SAME grade (e.g. a Grade
// Coordinator plus per-section Class Teachers) — no overlap rule here.
// Uniqueness is on the SLOT, not the teacher: at most one Grade
// Coordinator/Class Teacher per class-or-section per session, while the
// same teacher can hold multiple such slots across different
// grades/sections. Session-scoped, never carried forward (same as
// TeacherGradeAssignment/TeacherAcademicAssignment). Not audited, real
// DELETE route — current-state operational data, not a permanent
// decision.
model ClassTeacherAssignment {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([schoolGradeId, sectionId, academicSessionId])
  @@index([teacherId])
  @@index([academicSessionId])
}

// One row per student per calendar day — never subject-based. date is
// always derived from a "YYYY-MM-DD" string via new Date(dateString)
// (same convention as AcademicSession.startDate/endDate), giving a
// consistent UTC-midnight value regardless of server timezone — the
// server never computes "today" itself. schoolGradeId/sectionId are a
// snapshot of the student's GradeHistory placement at marking time.
model Attendance {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  date              DateTime
  status            String // PRESENT | ABSENT | LATE | EXCUSED
  remarks           String?
  markedByUserId    String
  markedBy          User            @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])
  markedAt          DateTime        @default(now())

  audits AttendanceAudit[]

  @@unique([studentId, date])
  @@index([schoolGradeId, sectionId, date])
  @@index([academicSessionId])
}

// Append-only correction log for Attendance — mirrors GradeHistoryAudit.
// A correction (status and/or remarks) updates the Attendance row AND
// inserts one of these in the same transaction, via correctAttendance()
// in src/lib/attendance.ts — never a silent overwrite. Both status and
// remarks are captured on every audit row, even if only one changed.
model AttendanceAudit {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedBy       User       @relation("AttendanceAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())
  previousStatus  String
  newStatus       String
  previousRemarks String?
  newRemarks      String?

  @@index([attendanceId])
}

// The teacher's declared teaching-plan context for one subject in one
// grade/section/session: how many Units/Chapters they intend to cover
// in total, and which display term they use ("Unit"/"Chapter"/free
// text — display-only, never enforced). Deliberately separate from
// TeachingUnit — the planned total is a standalone target that doesn't
// move when units are created or completed, and can be entered before
// any TeachingUnit row exists. Optional: no row means no plan is set,
// and progress views fall back to raw counts with no percentage-of-
// plan. Write path is find-or-update-else-create (app-level, not a
// bare insert) since at most one plan should exist per
// (gradeSubjectId, sectionId) — the same low-concurrency reasoning as
// the one-ACTIVE-session-per-school rule, since a plain @@unique can't
// reliably catch two sectionId: null rows colliding.
model TeachingPlan {
  id                String          @id @default(cuid())
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  plannedTotal      Int
  unitLabel         String          @default("Unit")
  createdByUserId   String
  createdBy         User            @relation("TeachingPlanCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([gradeSubjectId, sectionId])
  @@index([academicSessionId])
}

// A subject's curriculum unit/chapter — the school/teacher's own
// wording ("Unit 1: Numbers" or "Chapter 1: Numbers") lives in `title`;
// nothing here forces either term (see TeachingPlan.unitLabel for the
// display preference). gradeSubjectId enforces that a unit can only be
// created for a subject the grade actually offers this session.
// sectionId null = grade-wide unit sequence (shared by every section);
// a real value = that section's own, independent sequence. `order` is
// app-assigned (current count + 1 within its own gradeSubjectId+
// sectionId scope), not a DB unique constraint — the same NULL-in-
// unique-index issue as elsewhere in this schema would resurface for
// grade-wide (sectionId: null) units otherwise.
model TeachingUnit {
  id                String          @id @default(cuid())
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  title             String
  order             Int
  status            String          @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  startedAt         DateTime?
  completedAt       DateTime?
  createdByUserId   String
  createdBy         User            @relation("TeachingUnitCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tests UnitTest[]

  @@index([gradeSubjectId, sectionId])
  @@index([academicSessionId])
}

// A Unit/Chapter Test — created only once its TeachingUnit is
// IN_PROGRESS or COMPLETED (route-level rule, not a DB constraint; see
// PRODUCT_RULES.md). Multiple tests per unit are allowed (e.g. a quiz
// and a chapter test) — no uniqueness constraint blocks it.
model UnitTest {
  id              String       @id @default(cuid())
  unitId          String
  unit            TeachingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title           String
  testDate        DateTime
  maxMarks        Int
  createdByUserId String
  createdBy       User         @relation("UnitTestCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  results UnitTestResult[]

  @@index([unitId])
}

// Pre-created for every currently-enrolled student in the test's scope
// (via GradeHistory, matching the unit's own schoolGradeId/sectionId)
// at test-creation time, status PENDING — so "pending vs. evaluated vs.
// absent" is a real, directly-queryable column, not inferred by
// diffing against a roster that could change later. No retest concept.
model UnitTestResult {
  id                String    @id @default(cuid())
  unitTestId        String
  unitTest          UnitTest  @relation(fields: [unitTestId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            String    @default("PENDING") // PENDING | EVALUATED | ABSENT
  marksObtained     Float?
  remarks           String?
  evaluatedByUserId String?
  evaluatedBy       User?     @relation("UnitTestResultEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  evaluatedAt       DateTime?

  @@unique([unitTestId, studentId])
  @@index([studentId])
}

// ============================================================
// HOMEWORK — Phase 1
// One row per teacher-created homework item, shared by every student it
// applies to — deliberately NOT fanned out into a per-student row the
// way UnitTestResult is (that exists specifically for per-student
// *grading*, which Homework does not have in this phase). Student and
// Parent visibility is resolved entirely at read time, by matching a
// student's current GradeHistory placement (schoolGradeId/sectionId,
// this session) against a Homework row's own scope — see
// src/lib/homework.ts. sectionId null = grade-wide (every section);
// a real value = that section only — the same three-way idiom already
// used by TeachingUnit/StudentEvaluation/ClassTeacherAssignment via
// sectionScopeWhere() in src/lib/authorize.ts.
//
// teacherId references the Teacher identity directly (not just a
// createdByUserId → User audit field, unlike TeachingUnit/UnitTest) —
// matching StudentEvaluation's precedent, deliberately, so authorship
// resolves through the institutional Teacher identity rather than the
// raw account. gradeSubjectId is the source-of-truth that this subject
// is actually offered at this grade/session (the same role it plays for
// TeacherAcademicAssignment/TeachingUnit); subjectId/schoolGradeId/
// academicSessionId are denormalized alongside it purely for query
// convenience, same precedent.
//
// dueDate is date-only, following the Attendance.date/UnitTest.testDate
// convention: always derived from a client-supplied "YYYY-MM-DD"
// string, never a server-computed "today" — see src/lib/homework.ts for
// how "today" is resolved for the Student/Parent read side specifically
// (Asia/Kathmandu, not the server's own clock/UTC).
//
// status is DRAFT | PUBLISHED — a single gate for both Student and
// Parent visibility simultaneously (not two independent flags like
// StudentEvaluation's visibleToParent/visibleToStudent), since nothing
// in this phase's product direction calls for an asymmetric audience.
// publishedAt is null while DRAFT, set once at the DRAFT->PUBLISHED
// transition.
model Homework {
  id                String          @id @default(cuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  gradeSubjectId    String
  gradeSubject      GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id])

  title        String
  instructions String
  dueDate      DateTime

  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?

  // K1 — null = Regular Homework (applies to the grade/section above,
  // resolved into HomeworkApplicability at publish time). Set =
  // Individual Homework, targeting exactly this one student instead —
  // schoolGradeId/subjectId above still describe its academic context
  // (needed for teacher-assignment validation), but sectionId becomes
  // irrelevant to who this applies to. Re-validated fresh at publish
  // time (see publishHomework() in src/lib/homework.ts), never trusted
  // from whenever the draft was created — the same "never derive from a
  // stale earlier read" discipline this schema already applies
  // elsewhere (AcademicSession, AssessmentComponentResult).
  targetStudentId String?
  targetStudent   Student? @relation("IndividualHomeworkTarget", fields: [targetStudentId], references: [id], onDelete: Cascade)

  applicability HomeworkApplicability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supports the core read pattern directly: "published homework due on
  // this date, for this grade" (src/lib/homework.ts's
  // fetchTodaysHomework, and the teacher-facing list/filter view) —
  // both are equality lookups, so a single compound index in this
  // column order serves both without a redundant second index.
  @@index([schoolGradeId, dueDate])
  @@index([academicSessionId])
  @@index([teacherId])
}

// K1 — the ONE canonical, universal Student <-> Homework relationship.
// Homework.studentId does not exist and must not be added; this model
// is the sole answer to "does this homework apply to this student."
// Regular Homework: one Homework -> many rows, resolved from the
// current grade/section roster (GradeHistory) at the exact moment of
// publish. Individual Homework: one Homework -> exactly one row, for
// Homework.targetStudentId, also resolved at publish (see
// publishHomework(), src/lib/homework.ts).
//
// Created once, in a batch, inside the same transaction as the
// DRAFT -> PUBLISHED transition — never at draft creation, never
// recalculated afterward. Immutable in K1: no update or delete path
// exists for this model at all. A student's later section change,
// grade change, school transfer, or affiliation ending never rewrites
// or removes an existing row here — "disassociate != delete," the same
// principle already governing GradeHistory/affiliations everywhere
// else in this schema. This is a historical institutional fact, not a
// live-derived membership check.
model HomeworkApplicability {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Stamped once from the same timestamp used for Homework.publishedAt
  // in the same publish transaction — every row in one publish batch
  // shares one exact instant, never an independent now() per row.
  assignedAt DateTime

  // The database-level backstop behind the publish transaction's own
  // fresh-status guard (see publishHomework()) — structurally prevents
  // a duplicate applicability row for the same (homework, student) pair
  // regardless of how the duplicate attempt happened.
  @@unique([homeworkId, studentId])
  // Every Student/Parent read, and every future Completion/Submission/
  // Feedback join, is "give me this student's applicable homework."
  @@index([studentId])

  completion HomeworkCompletion?
  submissionAttempts HomeworkSubmissionAttempt[]
  reviews            HomeworkReview[]
}

// K2 — one student's completion decision for one HomeworkApplicability
// row. The Subject Teacher is the sole authoritative recorder — see
// recordOrCorrectCompletion() (src/lib/homeworkCompletion.ts), the only
// code path allowed to write here. Absence of a row for a given
// HomeworkApplicability means "completion has not yet been recorded" —
// this must NEVER be read as NOT_COMPLETED, ABSENT, or EXCUSED by any
// caller, and no backfill exists or will ever be added for pre-K2
// Homework/Applicability rows.
//
// One CURRENT row per Applicability (update-in-place), not a
// MarkSheet-style version chain: nothing downstream ever needs to
// reference "completion as of a past moment" the way a Report Card
// references a frozen Mark Sheet, so a single mutable row plus the
// append-only HomeworkCompletionAudit below gives full correction
// history without the "find the current non-superseded version" query
// complexity a chain would add — the same shape Attendance/
// StudentEvaluation already use for a teacher's correctable, day-to-day
// recorded judgment.
model HomeworkCompletion {
  id                      String                @id @default(cuid())
  homeworkApplicabilityId String                @unique
  homeworkApplicability   HomeworkApplicability @relation(fields: [homeworkApplicabilityId], references: [id], onDelete: Cascade)

  status     String // COMPLETED | PARTIAL | NOT_COMPLETED | EXCUSED
  recordedAt DateTime

  // The real institutional Teacher identity, not a raw User FK —
  // matches Homework.teacherId/StudentEvaluation.teacherId's
  // established precedent: authorship resolves through the Teacher
  // identity, never the raw account. Reflects whoever most recently
  // recorded/corrected this row (same "latest actor" semantics as
  // Attendance.markedByUserId / AssessmentComponentResult.
  // evaluatedByUserId) — full history of who changed what, when, lives
  // in HomeworkCompletionAudit below, not here.
  recordedByTeacherId String
  recordedByTeacher   Teacher @relation("HomeworkCompletionRecordedBy", fields: [recordedByTeacherId], references: [id])

  // K2 — optimistic-lock CAS guard for recordOrCorrectCompletion() (see
  // src/lib/homeworkCompletion.ts). Every successful correction
  // increments this by exactly 1, inside the same transaction as the
  // update; a correction submitted against a version that no longer
  // matches the row's current version is rejected rather than silently
  // overwriting a change it never saw — the same H3 pattern already
  // proven for AssessmentComponentResult/StudentEvaluation, adopted
  // here deliberately (not by default) because TeacherAcademicAssignment
  // explicitly permits more than one teacher to hold an overlapping
  // assignment for the same subject/grade/section, making a genuine
  // two-teacher race a real, non-hypothetical scenario for Homework
  // specifically.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits HomeworkCompletionAudit[]

  @@index([recordedByTeacherId])
}

// Append-only correction log for HomeworkCompletion — mirrors
// AttendanceAudit exactly. Written on every correction (never on the
// first recording — creation isn't a correction, the same "creation
// isn't a decision" reasoning already applied to GradeHistoryAudit/
// StudentEvaluationAudit).
model HomeworkCompletionAudit {
  id                   String             @id @default(cuid())
  homeworkCompletionId String
  homeworkCompletion   HomeworkCompletion @relation(fields: [homeworkCompletionId], references: [id], onDelete: Cascade)
  changedByTeacherId   String
  changedByTeacher     Teacher            @relation("HomeworkCompletionAuditChangedBy", fields: [changedByTeacherId], references: [id])
  changedAt            DateTime           @default(now())
  previousStatus       String
  newStatus            String

  @@index([homeworkCompletionId])
}

// ============================================================
// K3 — HOMEWORK SUBMISSION
// Optional student-provided evidence, entirely independent of
// HomeworkCompletion — the core product principle: "Completion is the
// primary fact. Online submission is optional evidence." A student may
// be COMPLETED with zero submission rows (offline homework, checked
// physically), or may submit evidence and still be recorded PARTIAL —
// neither model ever reads or writes the other. Anchored directly to
// HomeworkApplicability (never Homework.studentId, never a second
// Student <-> Homework relationship), as a sibling of HomeworkCompletion
// under the same canonical parent.
// ============================================================

// One immutable attempt by the student to submit evidence for one
// HomeworkApplicability. Multiple attempts are expected and normal (a
// resubmission is simply a new row, even after Completion has already
// been recorded — Completion and Submission never gate each other).
// No update or delete route exists or should ever exist for this model
// — a correction is always a new attempt, never an edit to an old one,
// matching this schema's dominant "append, never overwrite" discipline
// (GradeHistory, Certificate, MarkSheet).
model HomeworkSubmissionAttempt {
  id                      String                @id @default(cuid())
  homeworkApplicabilityId String
  homeworkApplicability   HomeworkApplicability @relation(fields: [homeworkApplicabilityId], references: [id], onDelete: Cascade)

  // App-assigned (current count + 1, within this applicability's own
  // scope), matching TeachingUnit.order's existing idiom — never a bare
  // insert order, since attempts must be stably numbered for display
  // ("Attempt 1", "Attempt 2") regardless of any future query ordering
  // change. @@unique below is the database-level backstop against a
  // duplicate attempt number, the same "belt and suspenders" relationship
  // already used throughout this schema's other numbered/CAS models.
  attemptNumber Int

  submittedAt DateTime

  // Derived exactly once, at submission time, from submittedAt vs. the
  // parent Homework's own dueDate (already frozen post-publish) — never
  // recomputed live. Matches this schema's "snapshot at the moment it
  // matters" precedent (Certificate, MarkSheet, GradeHistoryAudit).
  isLate Boolean

  // At least one of textContent/fileUrl is required (enforced at the
  // application layer — see src/lib/homeworkSubmission.ts); both may be
  // present on the same attempt. Deliberately NOT two separate models
  // (TextSubmission/FileSubmission) — one attempt is one act of
  // evidence, which may combine a note and a photo.
  textContent String?
  // Root-relative path into the PRIVATE (non-public) storage directory
  // used by saveSubmissionFile() (src/lib/uploads.ts) — deliberately
  // NEVER a /uploads/... public URL. Served only through the
  // authenticated file route (src/app/api/homework-submissions/[id]/
  // file/route.ts), which re-verifies the caller's authorization to
  // this exact HomeworkApplicability before streaming any bytes.
  filePath String?

  // The STUDENT's own account, resolved fresh from the session at
  // submission time — never trusted from client input, never a
  // teacher/admin/parent "on behalf of" actor. This is the one field
  // that anchors "who actually did this work" for accountability.
  submittedByUserId String
  submittedByUser    User   @relation("HomeworkSubmissionAttemptSubmittedBy", fields: [submittedByUserId], references: [id])

  createdAt DateTime @default(now())

  reviews HomeworkReview[]

  @@unique([homeworkApplicabilityId, attemptNumber])
  @@index([homeworkApplicabilityId])
}

// ============================================================
// K4 — HOMEWORK REVIEW / FEEDBACK
// The Subject Teacher's response — independent of submission (a review
// may exist for a purely offline-checked homework, with no submission
// attempt at all) and independent of Completion (feedback never implies
// or requires a particular completion status). Anchored to
// HomeworkApplicability, with an OPTIONAL pointer to the specific
// HomeworkSubmissionAttempt it responds to, when one exists.
// ============================================================

// One append-only review/feedback entry. Multiple reviews for the same
// HomeworkApplicability are expected (a resubmission naturally invites
// another review) and are NEVER collapsed into one editable row — no
// update or delete route exists. A correction to earlier feedback is
// always a new review entry, preserving the full round-by-round history
// ("Submission 1 -> Review 1 -> Feedback 1, resubmit -> Review 2 ->
// Feedback 2") exactly as the approved product design specifies.
// Visible to the Student/Parent immediately on creation — no private-
// until-shared gate in v1 (an explicit, approved product decision, not
// an oversight — contrast with StudentEvaluation's own visibleToParent/
// visibleToStudent flags, deliberately not reused here).
model HomeworkReview {
  id                      String                     @id @default(cuid())
  homeworkApplicabilityId String
  homeworkApplicability   HomeworkApplicability      @relation(fields: [homeworkApplicabilityId], references: [id], onDelete: Cascade)

  // Optional — informational linkage only, never authorization-relevant
  // and never required. A review anchored to no particular attempt is
  // exactly as valid as one anchored to a specific attempt.
  submissionAttemptId String?
  submissionAttempt   HomeworkSubmissionAttempt? @relation(fields: [submissionAttemptId], references: [id])

  // App-assigned, same numbering idiom as attemptNumber above.
  reviewNumber Int

  feedback String

  // The real institutional Teacher identity — matches
  // HomeworkCompletion.recordedByTeacherId/Homework.teacherId's
  // established precedent. Multiple different teachers may each leave
  // their own review rows for the same HomeworkApplicability (no
  // hierarchy among co-teachers, the same precedent already established
  // for TeacherAcademicAssignment/Homework PATCH/HomeworkCompletion).
  reviewedByTeacherId String
  reviewedByTeacher   Teacher @relation("HomeworkReviewReviewedBy", fields: [reviewedByTeacherId], references: [id])

  reviewedAt DateTime @default(now())

  @@unique([homeworkApplicabilityId, reviewNumber])
  @@index([homeworkApplicabilityId])
}

// ============================================================
// ASSESSMENT & EVALUATION — Phase 3C
// Additive on top of Phase 2/3A/3B — no existing model's columns
// changed, only new relation-array fields. StudentEvaluation is a
// narrative record distinct from UnitTestResult (marks): a Subject
// Teacher's remark (gradeSubjectId set) or a Grade Class/Section
// Teacher's general remark (gradeSubjectId null) about a student's
// broader development. The UI derives "General" vs "Subject" labeling
// from whether gradeSubjectId is set — no separate type field.
// ============================================================

// A teacher's qualitative, narrative evaluation of a student — freely
// editable while private (visibleToParent and visibleToStudent both
// false). Once shared with EITHER audience, further remarks changes
// must go through updateEvaluationRemarks() (src/lib/evaluation.ts),
// which pairs every subsequent edit with a StudentEvaluationAudit row
// in the same transaction — so previously shared information can never
// be silently rewritten. Sharing itself (flipping visibleToParent/
// visibleToStudent to true) is a one-way action in this phase — no
// un-share path exists, matching how a Certificate is permanent once
// issued elsewhere in this schema.
model StudentEvaluation {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  sectionId         String?
  section           Section?        @relation(fields: [sectionId], references: [id])
  // null = general/pastoral evaluation (Grade Coordinator or Class
  // Teacher, via requireClassTeacher); set = subject-specific evaluation
  // (Subject Teacher, via requireTeacherAssignment). The UI derives its
  // "General Student Evaluation" vs "Subject Evaluation" label from
  // this field alone.
  gradeSubjectId    String?
  gradeSubject      GradeSubject?   @relation(fields: [gradeSubjectId], references: [id])

  remarks String

  // Two fully independent visibility gates — a Student-visible
  // evaluation is not automatically Parent-visible, or vice versa.
  visibleToParent     Boolean   @default(false)
  sharedWithParentAt  DateTime?
  visibleToStudent    Boolean   @default(false)
  sharedWithStudentAt DateTime?

  // H3 — optimistic-lock guard for updateEvaluationRemarks() (see
  // src/lib/evaluation.ts). Every successful correction increments this
  // by exactly 1, inside the same transaction as the update itself; a
  // correction submitted against a version that no longer matches the
  // row's current version is rejected rather than silently overwriting
  // a change it never saw.
  version Int @default(1)

  createdByUserId String
  createdBy       User     @relation("StudentEvaluationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  audits   StudentEvaluationAudit[]
  meetings ParentTeacherMeeting[]

  // NOTE: this constraint reliably catches an exact duplicate
  // subject-specific slot, but — the same NULL≠NULL unique-index gap
  // already found and fixed twice elsewhere in this schema
  // (TeacherAcademicAssignment, ClassTeacherAssignment) — does NOT by
  // itself catch a second general (gradeSubjectId: null) evaluation
  // from the same teacher/student/session. The create route pre-checks
  // that case explicitly, inside the same transaction, from the start.
  @@unique([studentId, teacherId, academicSessionId, gradeSubjectId])
  @@index([studentId])
}

// Append-only correction log for StudentEvaluation, written only once
// an evaluation has been shared with a Parent and/or a Student — mirrors
// GradeHistoryAudit/AttendanceAudit's shape exactly.
model StudentEvaluationAudit {
  id              String            @id @default(cuid())
  evaluationId    String
  evaluation      StudentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedBy       User              @relation("StudentEvaluationAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime          @default(now())
  previousRemarks String
  newRemarks      String
}

// A scheduled meeting between a Teacher and a Student's Parent(s),
// initiated by a School Admin or an authorized Teacher — Parents are
// read-only recipients in this phase (see PRODUCT_RULES.md). Covers
// both periodic (bulk-scheduled, e.g. a PTM week for a whole grade) and
// occasional (single) meetings through the same model and the same
// create route — the only difference is how many rows one request
// creates. Parent-visible only; Students have no visibility into this
// model in this phase.
model ParentTeacherMeeting {
  id                 String             @id @default(cuid())
  schoolId           String
  school             School             @relation(fields: [schoolId], references: [id])
  academicSessionId  String
  academicSession    AcademicSession    @relation(fields: [academicSessionId], references: [id])
  studentId          String
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            Teacher            @relation(fields: [teacherId], references: [id])
  // null = general meeting; set = about one specific subject.
  gradeSubjectId     String?
  gradeSubject       GradeSubject?      @relation(fields: [gradeSubjectId], references: [id])
  scheduledAt        DateTime
  location           String?
  onlineUrl          String?
  status             String             @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED"
  outcomeNotes       String?
  // Optional link to an evaluation prepared ahead of the meeting and
  // discussed during it — many meetings may reference the same
  // evaluation (e.g. a follow-up meeting), so this is a plain FK, not a
  // unique one.
  linkedEvaluationId String?
  linkedEvaluation   StudentEvaluation? @relation(fields: [linkedEvaluationId], references: [id])
  createdByUserId    String
  createdBy          User               @relation("ParentTeacherMeetingCreatedBy", fields: [createdByUserId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([studentId])
  @@index([schoolId])
  // Calendar K1 — fetchMeetingsForTeacher() (Teacher Today Kilometer 1)
  // had no dedicated index on teacherId; Calendar's wider date-window
  // queries make this genuinely load-bearing rather than a someday
  // nice-to-have.
  @@index([teacherId])
}

// ============================================================
// ASSESSMENT FRAMEWORK FOUNDATION — Phase 3D-1
// Additive on top of Phase 2/3A/3B/3C — no existing model's columns
// changed, only new relation-array fields. This phase is
// configuration-only: no marks entry, aggregation, GPA calculation,
// report cards, or promotion logic exist yet. See
// docs/ASSESSMENT_FRAMEWORK.md.
//
// AssessmentFramework and GradingScale are reusable, school-wide
// templates — like Subject, NOT session-scoped like GradeSubject. The
// session-scoped piece is AssessmentFrameworkAssignment alone, which
// binds a (reusable) framework to one (AcademicSession, SchoolGrade),
// optionally narrowed to one GradeSubject — mirroring the exact
// Subject/GradeSubject split already established in Phase 3A, chosen
// deliberately over forcing a school to re-define its entire marking
// scheme from scratch every session (the cost of re-entering a
// framework's components/weights is much higher than re-picking a
// subject from an existing catalog).
// ============================================================

// A reusable marking-scheme template, defined once per school and
// assignable to any number of (session, grade) combinations over time
// — never hard-deleted once it may be assigned, deactivate only
// (isActive), same "retire by disuse" precedent as Subject/Section.
model AssessmentFramework {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // null = marks-only (no letter-grade conversion) or descriptive-only
  // system — see GradingScale below.
  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  periods     AssessmentPeriod[]
  components  AssessmentComponent[]
  assignments AssessmentFrameworkAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// An optional grouping layer under a framework ("Term I", "Mid-Term",
// "Annual"). A framework may define zero periods (a flat, single-block
// structure) or several. Not itself weight-bearing — a period's
// contribution to the framework total is simply the natural sum of its
// own components' maxMarks, the same as any other component grouping.
model AssessmentPeriod {
  id          String              @id @default(cuid())
  frameworkId String
  framework   AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  createdAt   DateTime            @default(now())

  components AssessmentComponent[]

  @@unique([frameworkId, name])
  @@index([frameworkId])
}

// One scored (or graded, or descriptive) piece of a framework —
// "Periodic Test", "Research & Presentation", "Theory". periodId null
// means the component hangs directly off the framework (no periods in
// use); a real value nests it under that period. maxMarks is the ONE
// number a component is worth, out of whatever the framework's
// components sum to — deliberately doing double duty as "marks" and
// "weight" rather than maintaining two parallel fields (a 10%-weighted
// component and a component worth 10 raw marks are the identical
// shape; only entryMode differs). entryMode controls how a student's
// result for this component will eventually be recorded (Phase 3D-2,
// not built yet): MARKS = a raw number 0..maxMarks; GRADE = a label
// picked from the framework's own GradingScale, converted to a
// maxMarks-weighted contribution via that label's gradePoint;
// DESCRIPTIVE = free text only, excluded from any numeric aggregate.
model AssessmentComponent {
  id          String              @id @default(cuid())
  frameworkId String
  framework   AssessmentFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  periodId    String?
  period      AssessmentPeriod?   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String
  maxMarks    Float
  entryMode   String              @default("MARKS") // "MARKS" | "GRADE" | "DESCRIPTIVE"
  order       Int
  createdAt   DateTime            @default(now())

  // NOTE: reliably catches an exact duplicate component within the
  // SAME real period, but — the same NULL≠NULL unique-index gap
  // documented repeatedly elsewhere in this schema (TeacherAcademicAssignment,
  // ClassTeacherAssignment, StudentEvaluation) — does NOT by itself
  // catch a second identically-named component with periodId: null
  // (framework-level, no period) under the same framework. The create
  // route pre-checks that case explicitly before creating, from the
  // start — see src/lib/assessmentFramework.ts.
  results AssessmentComponentResult[]

  @@unique([frameworkId, periodId, name])
  @@index([frameworkId])
  @@index([periodId])
}

// A reusable, school-wide marks→grade conversion table — "National
// Scale 2081", "Pass/Fail", "A1-B2 Scale". Shared across any number of
// AssessmentFrameworks. Never hard-deleted once a framework may
// reference it — deactivate only (isActive), same precedent as
// AssessmentFramework/Subject/Section.
model GradingScale {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bands                     GradingScaleBand[]
  frameworks                AssessmentFramework[]
  coScholasticGradeSettings CoScholasticGradeSetting[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// One percentage band within a GradingScale — "90-100 = A+, 4.0,
// Outstanding". gradePoint is optional: null where GPA math doesn't
// apply (e.g. a plain Pass/Fail scale with no grade-point concept).
// isPassing is optional and NEVER inferred from label text ("Fail",
// "D") — a school must explicitly mark which bands count as passing;
// null means "not specified," not "failing." Reserved for a future
// Promotion-roster reference display (Phase 3D-5+) — never read by
// recordGradeDecision() itself, which remains a human decision. Once
// any published result exists using this scale, minPercent/maxPercent/
// gradePoint/isPassing are locked (see PATCH
// /api/schools/[id]/grading-scales/[gradingScaleId]) — label/description
// wording may still be corrected freely.
model GradingScaleBand {
  id             String       @id @default(cuid())
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)
  minPercent     Float
  maxPercent     Float
  label          String
  gradePoint     Float?
  isPassing      Boolean?
  description    String?
  order          Int

  @@index([gradingScaleId])
}

// The ONLY session-scoped piece of this phase — binds a reusable
// AssessmentFramework to one (AcademicSession, SchoolGrade), optionally
// narrowed to one GradeSubject. gradeSubjectId null = the grade's
// DEFAULT framework, applying to every subject offered at that grade
// this session unless overridden; a real value = a subject-specific
// override for that one subject — the same nullable-scope-discriminator
// idiom already used three times elsewhere in this schema
// (TeachingUnit.sectionId, StudentEvaluation.gradeSubjectId,
// ParentTeacherMeeting.gradeSubjectId). Resolution rule (implemented in
// src/lib/assessmentFramework.ts): look up a subject-specific
// assignment first; fall back to the grade-default if none exists.
// Not audited — current-state operational config, same non-historical
// classification as GradeSubject/TeacherAcademicAssignment, with a real
// DELETE route to match.
model AssessmentFrameworkAssignment {
  id                String              @id @default(cuid())
  schoolId          String
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession     @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade         @relation(fields: [schoolGradeId], references: [id])
  gradeSubjectId    String?
  gradeSubject      GradeSubject?       @relation(fields: [gradeSubjectId], references: [id])
  frameworkId       String
  framework         AssessmentFramework @relation(fields: [frameworkId], references: [id])
  createdAt         DateTime            @default(now())

  componentResults AssessmentComponentResult[]
  publications     AssessmentResultPublication[]

  // NOTE: reliably catches a duplicate override for the SAME subject,
  // but — the identical NULL≠NULL gap as above — does NOT by itself
  // catch a second grade-default (gradeSubjectId: null) assignment for
  // the same grade/session. Pre-checked explicitly before creating; see
  // src/lib/assessmentFramework.ts.
  @@unique([academicSessionId, schoolGradeId, gradeSubjectId])
  @@index([academicSessionId])
  @@index([schoolGradeId])
  @@index([frameworkId])
}

// ============================================================
// ASSESSMENT RESULTS — Phase 3D-2/3/4
// Additive on top of Phase 3D-1 — no existing model's columns changed,
// only new relation-array fields. See docs/ASSESSMENT_RESULTS.md.
//
// Results are created LAZILY, never pre-created in bulk (a deliberate
// divergence from UnitTestResult's eager-roster pattern — see
// docs/ASSESSMENT_RESULTS.md for why: AssessmentComponent, unlike
// UnitTest, has no single clean "creation moment" to snapshot a roster
// against, since a framework's components can be added to it well
// after it's already assigned). Publication is subject-level
// (AssessmentResultPublication, keyed by gradeSubjectId + studentId),
// never per-component — a Parent/Student must never see a partially-
// published subject.
// ============================================================

// One student's raw entry against one AssessmentComponent. gradeSubjectId
// is required and resolved independently of whether the governing
// assignment is a grade-default or a subject-override — entering marks
// always happens in the context of one real subject. assignmentId
// freezes which AssessmentFrameworkAssignment was actually in effect
// at entry time, so a later re-assignment can never silently
// reinterpret an already-entered result (same "snapshot at the moment
// it matters" precedent as Certificate/GradeHistoryAudit).
model AssessmentComponentResult {
  id                String                        @id @default(cuid())
  componentId       String
  component         AssessmentComponent           @relation(fields: [componentId], references: [id], onDelete: Cascade)
  gradeSubjectId    String
  gradeSubject      GradeSubject                  @relation(fields: [gradeSubjectId], references: [id])
  assignmentId      String
  assignment        AssessmentFrameworkAssignment @relation(fields: [assignmentId], references: [id])
  studentId         String
  student           Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            String                        @default("PENDING") // PENDING | EVALUATED | ABSENT
  marksObtained     Float? // MARKS-mode raw entry
  gradeLabel        String? // GRADE-mode raw entry — a label from the framework's GradingScale
  remarks           String? // DESCRIPTIVE-mode content, or an optional note on any mode
  evaluatedByUserId String?
  evaluatedBy       User?                         @relation("AssessmentComponentResultEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  evaluatedAt       DateTime?

  // H3 — optimistic-lock guard for correctComponentResult() (see
  // src/lib/assessmentResults.ts). Every successful correction
  // increments this by exactly 1, inside the same transaction as the
  // update itself; a correction submitted against a version that no
  // longer matches the row's current version is rejected rather than
  // silently overwriting a change it never saw.
  version Int @default(1)

  audits AssessmentComponentResultAudit[]

  @@unique([componentId, studentId])
  @@index([studentId])
  @@index([gradeSubjectId])
  @@index([assignmentId])
}

// Append-only correction log for AssessmentComponentResult, written
// only once the parent subject's AssessmentResultPublication is
// PUBLISHED — mirrors StudentEvaluationAudit/AttendanceAudit exactly.
// correctComponentResult() (src/lib/assessmentResults.ts) is the only
// code path allowed to change an EVALUATED/ABSENT result.
model AssessmentComponentResultAudit {
  id                    String                    @id @default(cuid())
  resultId              String
  result                AssessmentComponentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  changedByUserId       String
  changedBy             User                      @relation("AssessmentComponentResultAuditChangedBy", fields: [changedByUserId], references: [id])
  changedAt             DateTime                  @default(now())
  previousStatus        String
  newStatus             String
  previousMarksObtained Float?
  newMarksObtained      Float?
  previousGradeLabel    String?
  newGradeLabel         String?
  previousRemarks       String?
  newRemarks            String?

  @@index([resultId])
}

// The ONE place "is this subject's result visible to Parent/Student
// yet" is decided — subject-scoped (gradeSubjectId + studentId), not
// per-component and not per-framework, so a Parent/Student never sees
// a partially-published subject. Created lazily (status: DRAFT) on
// first component entry for that student/subject; flipped to
// PUBLISHED only by an explicit action, which fails if any required
// (non-DESCRIPTIVE) component is still PENDING. A correction to an
// already-PUBLISHED result does NOT revert this row to DRAFT — it
// stays published and the correction is captured in
// AssessmentComponentResultAudit instead (matching StudentEvaluation's
// "once shared, corrections are audited, not un-shared" precedent).
model AssessmentResultPublication {
  id                String                        @id @default(cuid())
  gradeSubjectId    String
  gradeSubject      GradeSubject                  @relation(fields: [gradeSubjectId], references: [id])
  studentId         String
  student           Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId      String
  assignment        AssessmentFrameworkAssignment @relation(fields: [assignmentId], references: [id])
  status            String                        @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt       DateTime?
  publishedByUserId String?
  publishedBy       User?                         @relation("AssessmentResultPublicationPublishedBy", fields: [publishedByUserId], references: [id])
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([gradeSubjectId, studentId])
  @@index([studentId])
}

// ============================================================
// MARK SHEET — the formal, immutable, issued annual academic result
// document. See docs/MARK_SHEET.md.
//
// Distinct from the Report Card: the Report Card (buildReportCard(),
// /dashboard/report-card/[studentId]) is a live, periodic, always-
// current projection of assessment data, including attendance and
// remarks. A Mark Sheet is issued exactly once (per version) at the
// END of an AcademicSession, represents the FINAL ANNUAL result only,
// and never changes — a later correction creates a new version rather
// than editing this row. No FinalAnnualResult model exists or is
// needed: the final result is formed live, at Issue time, by the
// existing calculation engine (fetchAssessmentResults()/
// computeSubjectResultFromParts(), src/lib/assessmentResults.ts) and
// the existing GradeHistory promotion decision (recordGradeDecision(),
// src/lib/gradeHistory.ts) — Issue only freezes both into this row and
// its MarkSheetSubject children. See issueMarkSheet() in
// src/lib/markSheet.ts, the only code path allowed to create one.
//
// Identity is Student.id, never User.id — a Student with no User
// account (Student.userId null) can still receive a Mark Sheet;
// studentMegaIdSnapshot is simply left null in that case, never
// fabricated. studentId/schoolId/academicSessionId are live FKs used
// only for identity/scoping/indexing — every DISPLAYED value is a
// separate *Snapshot field, frozen at issuance, so a later school
// rename, student name change, or grade-label edit can never alter an
// already-issued document (the same principle already proven by
// Certificate.*NameSnapshot).
// ============================================================

// One version of one issued Mark Sheet, for one Student, one
// AcademicSession. A correction never edits this row — it creates a
// new MarkSheet row (version + 1) and marks this one SUPERSEDED,
// linked forward via supersededByMarkSheetId. Old versions are never
// deleted; they remain permanently retrievable (see docs/MARK_SHEET.md
// for the full correction/versioning flow and its concurrency design).
model MarkSheet {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])

  // Versioning — see model-level comment. Uniqueness on
  // (studentId, academicSessionId, version) is the DB-level integrity
  // net: it makes a duplicate version number for the same student's
  // same session physically impossible to insert, which also doubles
  // as the concurrency guard for two simultaneous Issue/correction
  // attempts (the losing transaction's insert fails outright, never
  // silently creating a competing version). "Only one non-SUPERSEDED
  // version at a time" is enforced app-level via an optimistic-lock
  // update when superseding (see issueMarkSheet()/correctMarkSheet())
  // — the same "app-level, not DB-level" idiom already used throughout
  // this schema (AcademicSession, TeacherSchoolAffiliation) for a rule
  // SQLite's lack of partial unique indexes can't express directly.
  version Int    @default(1)
  status  String @default("ISSUED") // "ISSUED" | "SUPERSEDED"

  issuedAt                    DateTime @default(now())
  issuedByUserId              String
  issuedBy                    User     @relation("MarkSheetIssuedBy", fields: [issuedByUserId], references: [id])
  issuerNameSnapshot          String
  schoolNameSnapshot          String
  academicSessionNameSnapshot String
  gradeDisplayNameSnapshot    String
  sectionNameSnapshot         String?
  studentNameSnapshot         String
  // Null when the Student has no linked User at issuance time —
  // deliberately never fabricated. See PHASE 10 (userless-student test)
  // in the implementation this model was built for.
  studentMegaIdSnapshot       String?

  // The final academic progression outcome, frozen from the ALREADY-
  // RECORDED GradeHistory decision for this (studentId,
  // academicSessionId) — never re-decided or auto-calculated here. Uses
  // the exact same four-way GRADE_HISTORY_STATUSES vocabulary as
  // GradeHistory.status (src/lib/gradeHistory.ts) rather than
  // collapsing to a binary Promoted/Not-Promoted, so TRANSFERRED/LEFT
  // are never misrepresented as "not promoted." outcomeGradeDisplayNameSnapshot
  // is the destination grade's display name when the decision recorded
  // one (Promote/Repeat); null for TRANSFERRED/LEFT, which have none.
  outcomeStatus                   String
  outcomeGradeDisplayNameSnapshot String?

  // Cross-subject GPA at issuance, when the school's grading system
  // resolves one (computeUnweightedGPA()) — null for a marks-only or
  // Pass/Fail school, never forced. Per-subject percentage/grade/point
  // live on MarkSheetSubject; this is the one document-level number
  // that has no natural subject-level home.
  gpaSnapshot Float?

  // Populated only on a version > 1 row — why THIS version exists.
  correctionReason String?

  // Forward pointer to the version that superseded this one — null
  // while this is the current version. One-to-one: a given row can be
  // superseded by exactly one newer version.
  supersededByMarkSheetId String?    @unique
  supersededBy            MarkSheet? @relation("MarkSheetSupersession", fields: [supersededByMarkSheetId], references: [id])
  supersededFrom          MarkSheet? @relation("MarkSheetSupersession")

  createdAt DateTime @default(now())

  subjects             MarkSheetSubject[]
  gradingBandSnapshots MarkSheetGradingBandSnapshot[]
  coScholasticResults  MarkSheetCoScholasticResult[]

  @@unique([studentId, academicSessionId, version])
  @@index([studentId])
  @@index([schoolId, academicSessionId])
  @@index([studentId, academicSessionId, status])
}

// One subject's frozen final-annual result within one MarkSheet
// version. Entirely immutable after creation — no route ever updates a
// MarkSheetSubject row. gradeSubjectId is an informational pointer only
// (never a Prisma relation, so GradeSubject's own real DELETE route,
// see its model comment, is never blocked by a permanent reference) —
// subjectNameSnapshot is always the actual, sole source for display,
// exactly the principle already proven by Certificate's *Snapshot
// fields. No pass/fail field here or on MarkSheet — an explicit,
// approved V1 product decision (see docs/MARK_SHEET.md), not an
// oversight.
model MarkSheetSubject {
  id          String    @id @default(cuid())
  markSheetId String
  markSheet   MarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)

  // Informational only — see model comment. Never joined live for
  // display.
  gradeSubjectId      String
  subjectNameSnapshot String
  order               Int

  marksObtained Float
  maximumMarks  Float
  percentage    Float?
  gradeLabel    String?
  gradePoint    Float?

  createdAt DateTime @default(now())

  @@unique([markSheetId, gradeSubjectId])
  @@index([markSheetId])
}

// A verbatim, frozen copy of the GradingScaleBand rows that applied to
// this Mark Sheet's subjects, captured at Issue time. Exists because
// GradingScaleBand.label/description remain editable even after a
// scale's numeric bands lock (once any published result uses it) — a
// live re-render of "today's" GradingScale on an old, immutable Mark
// Sheet could show wording that never matched what was true at
// issuance, even though MarkSheetSubject.gradeLabel itself is already
// a safe, frozen string. Grouped by gradingScaleNameSnapshot so a
// student whose subjects used more than one scale gets one clearly
// separate, correctly-labeled table per scale, never a merged or
// ambiguous one. Entirely immutable after creation, same as
// MarkSheetSubject — nothing ever updates a row here.
model MarkSheetGradingBandSnapshot {
  id          String    @id @default(cuid())
  markSheetId String
  markSheet   MarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)

  gradingScaleNameSnapshot String
  minPercent               Float
  maxPercent               Float
  label                    String
  gradePoint               Float?
  isPassing                Boolean?
  description              String?
  order                    Int

  createdAt DateTime @default(now())

  @@index([markSheetId])
}

// The frozen, annual (never period-scoped — see CoScholasticResult's
// own model comment on why no aggregation exists) co-scholastic grade
// per area, captured at Issue time alongside MarkSheetSubject in the
// same transaction. Optional/best-effort: a missing entry for an area
// never blocks Issue (Rosebud's own real annual document has no
// co-scholastic section at all and is still a complete, valid annual
// result). areaId is a plain informational scalar, never a Prisma
// relation — the same reasoning as MarkSheetSubject.gradeSubjectId:
// CoScholasticArea's own real deactivate-only lifecycle is never
// blocked by a permanent reference, and areaNameSnapshot is always the
// sole source for display. Entirely immutable after creation.
model MarkSheetCoScholasticResult {
  id          String    @id @default(cuid())
  markSheetId String
  markSheet   MarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)

  areaId             String
  areaNameSnapshot   String
  gradeLabelSnapshot String
  order              Int

  createdAt DateTime @default(now())

  @@unique([markSheetId, areaId])
  @@index([markSheetId])
}

// ============================================================
// CO-SCHOLASTIC — a second, parallel, non-numeric evaluation axis
// (Work Education, Art, Health & Physical Education, Discipline, etc.),
// structurally independent of the scholastic AssessmentFramework chain.
// See docs/CO_SCHOLASTIC.md. No calculation engine exists or is needed
// here — grades are ordinal labels, never aggregated across periods
// (real evidence: two real report-card samples show period grades
// side-by-side, never combined; there is no defined rule for
// "Term I: A + Term II: B -> Annual: ?"). The annual/final grade is
// always independently entered (coScholasticPeriodId: null on
// CoScholasticResult), never derived.
// ============================================================

// A school-wide, reusable catalog entry ("Work Education", "Art
// Education") — deliberately scale-agnostic, mirroring Subject. A
// grading scale is NOT owned here: real evidence (Modern Indian School)
// shows the SAME four areas graded on a 3-point scale for one grade and
// a 5-point scale for another, in the SAME school — see
// CoScholasticGradeSetting below for where the scale actually lives.
model CoScholasticArea {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())

  results CoScholasticResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Whether a grade uses period-scoped co-scholastic evaluation at all,
// scoped to (schoolGrade, academicSession) — deliberately NOT owned by
// any subject's AssessmentFramework, since co-scholastic cuts across
// every subject for a grade, not one. Zero rows for a grade+session
// means "evaluated once, annually" (Modern Indian Class IX's shape);
// rows named "Term I"/"Term II" mean "evaluated per period" (Class
// IV's shape) — the same "framework may define zero periods" idiom
// AssessmentPeriod already uses, decoupled from any one subject.
model CoScholasticPeriod {
  id                String          @id @default(cuid())
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  name              String
  order             Int
  createdAt         DateTime        @default(now())

  results CoScholasticResult[]

  @@unique([schoolGradeId, academicSessionId, name])
  @@index([schoolGradeId])
  @@index([academicSessionId])
}

// The grading-scale ownership for co-scholastic, resolved at exactly
// (school, grade, session) — one scale governs every CoScholasticArea
// for that grade that session, matching the real evidence (both
// examples use one uniform scale across all four areas within a
// grade) without inventing unevidenced per-area granularity. Reuses
// GradingScale/GradingScaleBand unchanged — a 3-point and a 5-point
// scale are just two ordinary GradingScale rows; no new scale
// mechanism.
model CoScholasticGradeSetting {
  id                String          @id @default(cuid())
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schoolGradeId     String
  schoolGrade       SchoolGrade     @relation(fields: [schoolGradeId], references: [id])
  gradingScaleId    String
  gradingScale      GradingScale    @relation(fields: [gradingScaleId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([schoolGradeId, academicSessionId])
  @@index([schoolId])
  @@index([academicSessionId])
}

// One student's grade for one area, for one scope. coScholasticPeriodId
// has exactly one meaning, the same nullable-discriminator idiom
// AssessmentComponent.periodId already uses: null = the full-session/
// annual entry for this area; a real id = scoped to that specific
// CoScholasticPeriod. The NULL≠NULL gap on the unique constraint below
// (two null-period rows for the same student+area would not collide at
// the DB level) is the same, already-documented SQLite limitation this
// schema already works around elsewhere (AssessmentComponent,
// AssessmentFrameworkAssignment, StudentEvaluation) — closed by an
// app-level pre-check before create, not a new problem.
model CoScholasticResult {
  id                   String              @id @default(cuid())
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  areaId               String
  area                 CoScholasticArea    @relation(fields: [areaId], references: [id])
  academicSessionId    String
  academicSession      AcademicSession     @relation(fields: [academicSessionId], references: [id])
  coScholasticPeriodId String?
  coScholasticPeriod   CoScholasticPeriod? @relation(fields: [coScholasticPeriodId], references: [id])
  gradeLabel           String
  evaluatedByUserId    String?
  evaluatedBy          User?               @relation("CoScholasticResultEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  evaluatedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([studentId, areaId, coScholasticPeriodId])
  @@index([studentId])
  @@index([areaId])
  @@index([academicSessionId])
}

// ============================================================
// ORGANIZATIONS
