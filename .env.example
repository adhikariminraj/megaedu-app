# PostgreSQL connection string. Local development uses the megaedu_dev
# database on this machine's PostgreSQL (localhost only). Replace
# YOUR_PASSWORD in your own .env — never commit a real password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/megaedu_dev?schema=public"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Set this to a real admin email + password before running the seed
# script if you want a working Platform Admin login in production.
SEED_ADMIN_EMAIL="admin@megaedu.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
