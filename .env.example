# Local dev default (SQLite file). For production, point this at a
# Postgres connection string (e.g. from Neon: https://neon.tech) and
# change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Set this to a real admin email + password before running the seed
# script if you want a working Platform Admin login in production.
SEED_ADMIN_EMAIL="admin@megaedu.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
